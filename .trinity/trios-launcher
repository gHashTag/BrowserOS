#!/bin/bash
# TRIOS Launcher — starts BrowserOS production server
# Double-click TRIOS.app to launch

set -euo pipefail

PROJECT_DIR="/Users/playra/BrowserOS/packages/browseros-agent"
LOG_FILE="/tmp/trios-launcher.log"
PID_FILE="/tmp/trios-launcher.pids"

echo "[$(date)] TRIOS starting..." > "$LOG_FILE"

# Kill any existing instances
if [ -f "$PID_FILE" ]; then
    echo "[$(date)] Stopping existing instances..." >> "$LOG_FILE"
    while read -r pid; do
        kill -9 "$pid" 2>/dev/null || true
    done < "$PID_FILE"
    rm -f "$PID_FILE"
fi

# Kill existing processes on our ports
lsof -ti:9105 | xargs kill -9 2>/dev/null || true
lsof -ti:9005 | xargs kill -9 2>/dev/null || true

cd "$PROJECT_DIR"

# Export env vars
export VITE_PUBLIC_BROWSEROS_API=https://api.browseros.com
export VITE_BROWSEROS_SERVER_PORT=9105
export BROWSEROS_SERVER_PORT=9105
export BROWSEROS_CDP_PORT=9005
export BROWSEROS_ALLOW_NO_CDP=1
export BROWSEROS_CONFIG_URL=http://localhost:8000

# Build production extension if not already built
if [ ! -d "apps/agent/dist/chrome-mv3" ]; then
    echo "[$(date)] Building production extension..." >> "$LOG_FILE"
    cd apps/agent && bun --env-file=.env.development wxt build >> "$LOG_FILE" 2>&1 || {
        echo "[$(date)] Build failed!" >> "$LOG_FILE"
        osascript -e 'display notification "TRIOS build failed! Check /tmp/trios-launcher.log" with title "TRIOS Error"'
        exit 1
    }
    cd "$PROJECT_DIR"
fi

# Start Chrome with CDP if not already running
if ! curl -s http://127.0.0.1:9005/json/version > /dev/null 2>&1; then
    echo "[$(date)] Starting Chrome with CDP..." >> "$LOG_FILE"
    EXTENSION_PATH="$PROJECT_DIR/apps/agent/dist/chrome-mv3"
    
    "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" \
        --remote-debugging-port=9005 \
        --load-extension="$EXTENSION_PATH" \
        --user-data-dir="/tmp/browseros-trios" \
        --no-first-run \
        --disable-default-apps \
        >> "$LOG_FILE" 2>&1 &
    echo $! >> "$PID_FILE"
    
    # Wait for CDP
    for i in $(seq 1 30); do
        curl -s http://127.0.0.1:9005/json/version > /dev/null 2>&1 && break
        sleep 1
    done
fi

# Start server
echo "[$(date)] Starting server..." >> "$LOG_FILE"
cd "$PROJECT_DIR/apps/server"
bun --env-file=.env.development src/index.ts >> "$LOG_FILE" 2>&1 &
SERVER_PID=$!
echo "$SERVER_PID" >> "$PID_FILE"

# Wait for server
for i in $(seq 1 30); do
    if curl -s http://127.0.0.1:9105/health > /dev/null 2>&1; then
        echo "[$(date)] Server ready!" >> "$LOG_FILE"
        break
    fi
    sleep 1
done

osascript -e 'display notification "TRIOS is running!" with title "TRIOS"'

# Keep alive
while kill -0 "$SERVER_PID" 2>/dev/null; do
    sleep 5
done

rm -f "$PID_FILE"
echo "[$(date)] TRIOS stopped." >> "$LOG_FILE"
