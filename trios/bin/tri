      for t in "${tags[@]}"; do pairs+=("tuned_${t}_rows:final_tuned_${t}"); done
      for pair in "${pairs[@]}"; do
        r=results/t27/tax12/${pair%%:*}.jsonl; c=results/t27/arena/${pair##*:}/cands.jsonl
