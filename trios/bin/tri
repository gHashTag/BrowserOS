  tc-abpair)
    # igla-coder-gpu: paired A/B of two arena final dirs (same items, seed
    # policy, engine): exact McNemar on per-item compile + pass and compiled
    # samples per mask arm. Light, local.
    #   tri tc-abpair final_tuned final_tuned_m12
    #   tri tc-abpair A B A_s12 B_s12      (per seed + POOLED replication test)
    #   tri tc-abpair                      (every tagged arm vs the baseline OF ITS
    #                                       SEED: *_sN -> final_tuned_old_sN, else
    #                                       final_tuned; never pairs across seeds)
    IG=/Users/playra/igla-coder-gpu
    cd "$IG" || exit 1
    shift
    if [ $# -ge 2 ]; then
      nice python3 scripts/tc_arena.py pair "$@"
    else
      for d in results/t27/arena/final_tuned_*/; do
        d=$(basename "$d"); [ "$d" = final_tuned_e8 ] && continue   # a candidate, not an arm
        case "$d" in
          final_tuned_old_s*) continue ;;                            # a baseline
          *_s[0-9]*) base="final_tuned_old_${d##*_}" ;;
          *) base=final_tuned ;;
        esac
        [ -d "results/t27/arena/$base" ] || { echo "== $d: no same-seed baseline $base, skipped"; continue; }
        echo "== $base vs $d"
        nice python3 scripts/tc_arena.py pair "$base" "$d"
      done
    fi
    ;;
  tc-seen)
    # seen-vs-unseen gold-body NLL per item group (did the fine-tune learn its bodies?) (igla-coder-gpu)
    shift; cd "$HOME/igla-coder-gpu" && exec nice python3 scripts/t27_seen_nll.py "$@" ;;
  tc-reach)
    # param reach at the return decision, teacher-forced on gold: P_param vs P_const,
    # pre-registered LIVE/PARTIAL/DEAD verdict; run before any 'must read X' rule (igla-coder-gpu)
    #   tri tc-reach --models work/arena/tuned.pt ... [--groups catalog bench]
    shift; cd "$HOME/igla-coder-gpu" && exec nice python3 scripts/t27_reach.py "$@" ;;
  tc-card)
    # render a tern_tc release from its card spec, then run its verify.sh on a COPY
    # (never inside the release tree) (igla-coder-gpu, loop 28)
    #   tri tc-card specs/hf/model_card_ft_b.t27 hf_release_ft_b
    shift; spec="${1:?usage: tri tc-card <card.t27> <release dir>}"; rel="${2:?release dir}"
    cd "$HOME/igla-coder-gpu" || exit 1
    node scripts/model_card_t27_from_spec.mjs --spec "$spec" --release "$rel" || exit 1
    tmp=$(mktemp -d "${TMPDIR:-/tmp}/tc-card.XXXXXX") && cp -R "$rel"/. "$tmp"/ \
      && (cd "$tmp" && sh scripts/verify.sh); rc=$?; rm -rf "$tmp"; exit $rc ;;
  tc-relabel)
    # judge relabeling: probe tests whose expected values t27c observes (igla-coder-gpu)
    shift; cd "$HOME/igla-coder-gpu" && exec nice python3 scripts/t27_relabel.py "$@" ;;
  tc-catalog)
    # igla-coder-gpu: new judgeable t27 items from the trinity website spec
    # catalog (stage locally -> items on Railway -> decon vs the bench).
    #   tri tc-catalog stage --catalog <trinity>/apps/website/public/t27/files
    #   tri tc-catalog decon | report
    # Remote recipe and leak classes: scripts/t27_catalog.py docstring.
    shift; cd "$HOME/igla-coder-gpu" && exec nice python3 scripts/t27_catalog.py "$@"
    ;;
  tc-ceiling)
    # igla-coder-gpu: the "sample more and select" ceiling from committed
    # artifacts -- union of items that EVER passed over every run, with the
    # diff-judge verdict per item. Price a selection lever before spending.
    #   tri tc-ceiling [results/t27/<dir> ...]   (default: arena finals + strict runs)
    cd /Users/playra/igla-coder-gpu || exit 1
