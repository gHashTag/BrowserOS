      --tokenizer results/data8k/tokenizer.json || exit 1
    # MERGE FIRST: parallel drivers write masked_tc_0/1/2.jsonl -- fold them
    # into the main file (dedup by id,k) before gen sees what is done.
    if compgen -G "results/t27/masked${MASK_VER:-3}_tc_[0-9]*.jsonl" > /dev/null; then
      python3 - "${MASK_OUT:-results/t27/masked${MASK_VER:-3}_tc.jsonl}" results/t27/masked${MASK_VER:-3}_tc_[0-9]*.jsonl <<'PYEOF'
import json, sys, os
main, seen = sys.argv[1], set()
if os.path.exists(main):
    for l in open(main):
        j = json.loads(l); seen.add((j["id"], j["k"]))
    rows = []
else:
    rows = []
with open(main, "a") as fo:
    added = 0
    for path in sys.argv[2:]:
        for l in open(path):
            j = json.loads(l)
            if (j["id"], j["k"]) in seen: continue
            seen.add((j["id"], j["k"])); fo.write(l); added += 1
print(f"folded {added} samples into {main} (now {len(seen)})")
PYEOF
    fi
    EXTRA=""
    [ -n "${MASK_OFF:-}" ] && EXTRA="--off"
    [ "${MASK_KV_I8:-0}" = "1" ] && EXTRA="$EXTRA --kv-i8"
    python3 scripts/t27_gen_masked.py --t27 "$WT" \
      --items t27/items.jsonl --cands results/t27/cands_tc.jsonl \
      --check results/t27/check_tc_partial/results.jsonl \
      --model c_infer/t27_tuned/model.bin --tokenizer results/data8k/tokenizer.json \
      --out "${MASK_OUT:-results/t27/masked${MASK_VER:-3}_tc.jsonl}" --slice 0:30 \
      --n "${MASK_N:-5}" --temperature 0.8 --threads "${MASK_THREADS:-2}" $EXTRA || exit 1
    python3 t27_bench.py check --t27 "$WT" --items t27/items.jsonl \
      --cands "${MASK_OUT:-results/t27/masked${MASK_VER:-3}_tc.jsonl}" \
      --out "results/t27/check_masked${MASK_VER:-3}/results.jsonl" \
      --t27c /tmp/t27c-build/target/release/t27c --workers 4
    ;;
  tc-t27selfcheck)
    # igla-coder-gpu: the model verifies ITSELF through t27c -- rounds of
    # (generate one sample per unresolved item -> t27c test-report -> stop
    # the item at its first pass). Arms rotate per round: m<temp> masked,
    # p<temp> plain. MEASURED 2026-09-29: diversity must come from mask
    # RULES, not temperatures (3 rule-arms: compile 15/30 union vs 3/30
    # for 3 temps); plain arms are dead weight -- defaults are masked-only.
    # Restart-safe: re-run with a larger --rounds to CONTINUE the rotation.
    # Env: SC_OUT (default results/t27/selfcheck1), SC_ROUNDS (5),
    # SC_ARMS (m0.8,w0.8,m0.7,w0.7 -- w = wide VALUE-core rule), SC_ITEMS (30), SC_STOP (pass|compile),
    # SC_SEED=<int> (deterministic per-job sampling seeds; PAIRED A/Bs:
    #   same seed base + same arms = identical streams, a pass delta is
    #   causal; without it tc_fast is time-seeded and 30-item pass counts
    #   are noise -- 2026-09-29 base30 3 vs repair30 0 on same code paths)
    # SC_WORKERS (3), SC_REPAIR=1 (strip module-level lines + unterminated
    # strings; keep ON), SC_EARLY=1 (abort repetition tail-locks mid-decode
    # via engine "x", cascade_abort n=6/reps=3 -- gold-safe 0/466, catches
    # 22/218 cascades; measured WEAK, A/B before trusting)
    # SC_ITEMS_FILE=<jsonl> (default t27/items.jsonl): a different item set,
    # e.g. results/t27/selftrain/items.jsonl (train-side yield; use SC_POOL=strict).
    # NOTE the mask core is computed from that file too.
    # SC_POOL=strict = every strict item (both mutants caught) of items.jsonl
    # -- the honest full-bench number; NOTE --n-items still CUTS the pool
    # after picking, so pass SC_ITEMS=500 with strict (the 2026-09-29 trap
    # that silently ran 30 of 391),
    # SC_KV_I8=1 (int8 KV cache: ~1.6x at 1.7K ctx,
    # approximate -- pass numbers not comparable to f32-KV runs).
    # SC_ANALYZE=1: free selector oracle over the
    # committed v1/v2/v3 mask artifacts -- no model, no generation.
    # The mask is FROZEN per run into <SC_OUT>/mask_snapshot.py (workers
    # re-import it each round; editing scripts/ mid-run is now safe).
    # SC_MASK_REV=<commit>: run with the mask as of that commit -- the
    # paired baseline arm of a mask A/B (e.g. 305105e = pre-typed mask).
    # SC_DIFF=1: every spec-test pass is diff-judged vs gold (diff_c tuples);
    # diff_kill = compile, not pass, and the item keeps sampling. Not
    # comparable to plain-pass runs. Heavy: run it remotely.
    IG=/Users/playra/igla-coder-gpu
    MASK_SRC=""
    if [ -n "${SC_MASK_REV:-}" ]; then
      MASK_SRC="${TMPDIR:-/tmp}/t27_mask_${SC_MASK_REV}.py"
      /Library/Developer/CommandLineTools/usr/bin/git -C "$IG" show \
        "$SC_MASK_REV:scripts/t27_gen_masked.py" > "$MASK_SRC" || exit 1
    fi
    WT=/tmp/t27-bench
    /Library/Developer/CommandLineTools/usr/bin/git -C "$HOME/t27" worktree list \
      | grep -q "$WT" || /Library/Developer/CommandLineTools/usr/bin/git -C "$HOME/t27" \
        worktree add --detach "$WT" ef7781b5 >/dev/null
    cd "$IG" || exit 1
    if [ -n "${SC_ANALYZE:-}" ]; then
      python3 scripts/t27_selfcheck.py --analyze \
        v1=results/t27/masked_tc.jsonl:results/t27/check_masked/results.jsonl \
        v2=results/t27/masked2_tc.jsonl:results/t27/check_masked2/results.jsonl \
        v3=results/t27/masked3_tc.jsonl:results/t27/check_masked3/results.jsonl
      return 0 2>/dev/null || exit 0
    fi
    # the mask gate first: this loop's masks come from t27_gen_masked
    python3 scripts/t27_mask_check.py --t27 "$WT" \
      --tokenizer results/data8k/tokenizer.json || exit 1
    T27_TREE="$WT" python3 scripts/t27_splice_audit.py --gold || exit 1
    python3 scripts/t27_selfcheck.py --t27 "$WT" \
      --t27c /tmp/t27c-build/target/release/t27c \
      --model c_infer/t27_tuned/model.bin --tokenizer results/data8k/tokenizer.json \
      --items "${SC_ITEMS_FILE:-t27/items.jsonl}" --cands results/t27/cands_tc.jsonl \
      --check results/t27/check_tc_partial/results.jsonl \
      --out "${SC_OUT:-results/t27/selfcheck1}" \
      --rounds "${SC_ROUNDS:-5}" --arms "${SC_ARMS:-m0.8,w0.8,m0.7,w0.7}" \
      --n-items "${SC_ITEMS:-30}" $([ "${SC_POOL:-failed}" = "strict" ] && echo --pool strict) \
      --gen-workers "${SC_WORKERS:-3}" \
      --stop-at "${SC_STOP:-pass}" $([ "${SC_KV_I8:-0}" = "1" ] && echo --kv-i8) \
      $([ "${SC_REPAIR:-0}" = "1" ] && echo --repair) \
      $([ -n "${SC_SEED:-}" ] && echo --gen-seed "$SC_SEED") \
      $([ "${SC_EARLY:-0}" = "1" ] && echo --early-abort) \
      $([ "${SC_PROBE:-0}" = "1" ] && echo --probe --probe-k "${SC_PROBE_K:-16}") \
      $([ -n "${SC_REDRAW:-}" ] && echo --redraw "$SC_REDRAW") \
      $([ -n "$MASK_SRC" ] && echo --mask-src "$MASK_SRC") \
      $([ "${SC_DIFF:-0}" = "1" ] && echo --diff results/t27/diff_c/items.jsonl)
    ;;
  tc-rounds)
    # igla-coder-gpu: poll a selfcheck run WITHOUT touching it -- recompute
    # the budget curves live from results.jsonl (summary.json only refreshes
    # when the run ends) + show round progress from the log. Same curve
    # semantics as scripts/t27_selfcheck.py: COMPILES=(pass,fail), samples
    # sorted by in-round k so arms interleave -- file-order polling
    # UNDERCOUNTS nothing but changes the x-axis meaning. Never a second
    # heavy run while one is live; this is the correct alternative.
    # Usage: tri tc-rounds [dir] [log]
    IG=/Users/playra/igla-coder-gpu
    D="${2:-results/t27/selfcheck1}"
    cd "$IG" || exit 1
    if [ -n "${3:-}" ] && [ -f "$3" ]; then grep '^round' "$3" | tail -3; fi
    python3 - "$D" <<'PYEOF'
import json, sys, collections
res = sys.argv[1] + "/results.jsonl"
try:
    rows = [json.loads(l) for l in open(res)]
except FileNotFoundError:
    sys.exit("no results.jsonl in " + sys.argv[1])
by = collections.defaultdict(list)
for j in rows:
    by[j["id"]].append((j["k"], j["status"]))
for iid in by:
    by[iid].sort()
COMPILES = ("pass", "fail")
for label, ok in (("compile", lambda s: s in COMPILES), ("pass", lambda s: s == "pass")):
    budgets = [next((i + 1 for i, (_, st) in enumerate(seq) if ok(st)), None)
               for seq in by.values()]
    line = "  ".join(f"b{b}:{sum(1 for x in budgets if x and x <= b)}"
                     for b in (1, 2, 3, 5, 10, 15, 20, 30))
    print(f"{label:8s} of {len(by)} items, {len(rows)} samples: {line}")
PYEOF
    ;;
  tc-draft)
    # igla-coder-gpu: tern_tc as a DRAFT MODEL FOR A VERIFIER -- one spec,
