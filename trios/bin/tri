    cd /Users/playra/igla-coder-gpu || exit 1
    shift
    exec bash scripts/gpu_ft_pod.sh "$@"
    ;;
  tc-podwait)
    # igla-coder-gpu: block until the first listed RunPod runq job is DONE
    # (loop 29; scripts/pod_wait.sh). Run it in the background.
    #   tri tc-podwait gpuft5a:gpu_ft5a gpuft5b:gpu_ft5b   (exit 0 done / 2 timeout)
    cd /Users/playra/igla-coder-gpu || exit 1
