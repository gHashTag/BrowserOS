    ;;
  tc-prefill)
    # igla-coder-gpu: prefill A/B bench -- chunked (default C) vs sequential
    # (TC_PREFILL_CHUNK=0) at several prompt sizes x thread counts, using the
    # E8 pair (/tmp/tt8 if present, else model3_q8). Prints the [split:] lines
    # and the speed ratio per cell; the exactness gate lives in tc-speed.
    # Env: PF_SIZES (comma list of prompt ids, default 512,1535,3990),
    #      PF_CHUNKS (default 32), PF_THREADS (default 1,5).
    IG=/Users/playra/igla-coder-gpu
    M=$IG/c_infer/model3_q8.bin
    [ -f /tmp/tt8/model.bin ] && M=/tmp/tt8/model.bin
    PF_SIZES=${PF_SIZES:-512,1535,3990}
    PF_CHUNKS=${PF_CHUNKS:-32}
    PF_THREADS=${PF_THREADS:-1,5}
    for n in $(echo $PF_SIZES | tr , ' '); do
      IDS=$(python3 -c "print(','.join((('1 3 204 276 405 659 85 1516 278 320 306 317 445 779 317 85 1516 740 306 317 705 779 317 85').split()*200)[:$n]))")
      for t in $(echo $PF_THREADS | tr , ' '); do
        TC_PREFILL_CHUNK=0 "$IG/c_infer/tc_fast" "$M" --simd --threads $t \
          --greedy --prompt-ids "$IDS" --max 10 2>/dev/null | grep 'split:' > /tmp/pf_seq.$$ 2>/dev/null
        s0=$(grep -o 'prefill [0-9]* ids in [0-9.]*s' /tmp/pf_seq.$$ | grep -o '[0-9.]*s$' | tr -d s)
        line="n$n t$t seq ${s0}s:"
        for c in $(echo $PF_CHUNKS | tr , ' '); do
          TC_PREFILL_CHUNK=$c "$IG/c_infer/tc_fast" "$M" --simd --threads $t \
            --greedy --prompt-ids "$IDS" --max 10 2>/dev/null | grep 'split:' > /tmp/pf_c.$$ 2>/dev/null
          sc=$(grep -o 'prefill [0-9]* ids in [0-9.]*s' /tmp/pf_c.$$ | grep -o '[0-9.]*s$' | tr -d s)
          [ -n "$s0" ] && [ -n "$sc" ] && ratio=$(python3 -c "print(f'x{$s0/$sc:.2f}')") || ratio='?'
          line="$line C$c ${sc}s $ratio;"
        done
        echo "$line"
      done
    done
    rm -f /tmp/pf_seq.$$ /tmp/pf_c.$$
    ;;
  tc-speed)
    # igla-coder-gpu: rebuild c_infer/tc_fast, run the near-parity gate,
    # then the greedy ladder (t1/t4/t5) and one sampled run. The one
    # command for "did the fast engine survive the night and how fast
    # is it now" -- the same sequence every speed change is gated by.
    IG=/Users/playra/igla-coder-gpu
    T=/tmp/t27c-build/target/release/t27c
    (cd "$IG/c_infer" && T27C="$T" make tc_fast 2>&1 | grep -E "error" && exit 1)
    (cd "$IG" && python3 scripts/parity_tc_fast.py --skip-build --nll-tol 0.05 \
      --model c_infer/model_q8.bin --model-fast c_infer/model3_q8.bin) | tail -1
    echo "-- greedy ladder (500 tok) --"
    for t in 1 4 5; do
      "$IG/c_infer/tc_fast" "$IG/c_infer/model3_q8.bin" --simd --threads $t \
        --greedy --prompt "module fib;" --tokens 500 2>&1 \
        | grep -o "= [0-9.]* tok/s" | sed "s/^/t$t /"
    done
    echo "-- sampled (default temp) --"
    "$IG/c_infer/tc_fast" "$IG/c_infer/model3_q8.bin" --simd --threads 5 \
      --prompt "module fib;" --tokens 500 2>&1 | grep -o "= [0-9.]* tok/s"
    echo "-- prefill A/B (1535-id prompt, t5; C0=sequential, C32=chunked default) --"
    IDS=$(python3 -c "print(','.join((('1 3 204 276 405 659 85 1516 278 320 306 317 445 779 317 85 1516 740 306 317 705 779 317 85').split()*70)[:1535]))")
    for c in 0 32; do
      TC_PREFILL_CHUNK=$c "$IG/c_infer/tc_fast" "$IG/c_infer/model3_q8.bin" --simd --threads 5 \
        --greedy --prompt-ids "$IDS" --max 50 2>&1 | grep 'split:' | sed "s/^/C$c /"
    done
    echo "-- kv-i8 ladder (gate: median|dNLL|<0.02 max<0.10) --"
    (cd "$IG" && python3 scripts/kv_ladder.py --files 3 --ctx 2048 \
      --threads 1,5 2>/dev/null || echo "kv ladder unavailable") | tail -7
    ;;
  tc-t27bench)
    # igla-coder-gpu: the t27 fill-in-the-middle bench on the C engine.
    # Generates 466 items x 10 samples from the t27-tuned tc model via
    # tc_fast (restart-safe, ~80 min first run) and judges them with the
    # exact judge (t27c test-report). Env knobs: T27_ITEMS, TC_MODEL,
    # CANDS, N. Prints the parse/compile/pass summary at the end.
    IG=/Users/playra/igla-coder-gpu
    WT=/tmp/t27-bench
    /Library/Developer/CommandLineTools/usr/bin/git -C "$HOME/t27" worktree list \
      | grep -q "$WT" || /Library/Developer/CommandLineTools/usr/bin/git -C "$HOME/t27" \
        worktree add --detach "$WT" ef7781b5 >/dev/null
    cd "$IG" || exit 1
    # regression gate first: mask-rule changes must keep the gold replay
    # and the unit invariants green (t27_mask_check exits 1 otherwise)
    python3 scripts/t27_mask_check.py --t27 "$WT" \
      --tokenizer results/data8k/tokenizer.json || exit 1
    # MERGE FIRST: if the run was parallelised, the side files
    # cands_tc_2a/2b exist -- fold them (dedup by id,k) back into CANDS
    # so the gen step sees their ids as done instead of redoing them.
    if compgen -G "results/t27/cands_tc_2*.jsonl" > /dev/null; then
      python3 - "${CANDS:-results/t27/cands_tc.jsonl}" results/t27/cands_tc_2*.jsonl <<'PYEOF'
import json, sys
main, seen = sys.argv[1], set()
rows = [l for l in open(main)]
for l in rows:
    j = json.loads(l)
    seen.add((j["id"], j["k"]))
with open(main, "a") as fo:
    added = 0
    for path in sys.argv[2:]:
        for l in open(path):
            j = json.loads(l)
            if (j["id"], j["k"]) in seen: continue
            seen.add((j["id"], j["k"]))
            fo.write(l)
            added += 1
print(f"folded {added} samples into {main} (now {len(seen)})")
PYEOF
    fi
    .venv-eval/bin/python3 scripts/t27_gen_tc.py --t27 "$WT" \
      --items "${T27_ITEMS:-t27/items.jsonl}" --model "${TC_MODEL:-c_infer/t27_tuned/model.bin}" \
      --tokenizer results/data8k/tokenizer.json --out "${CANDS:-results/t27/cands_tc.jsonl}" \
      --n "${N:-10}" --max-new 384 || exit 1
    python3 t27_bench.py check --t27 "$WT" --items "${T27_ITEMS:-t27/items.jsonl}" \
      --cands "${CANDS:-results/t27/cands_tc.jsonl}" --out results/t27/check_tc \
      --t27c /tmp/t27c-build/target/release/t27c --workers 4
    ;;
  tc-t27mask)
    # igla-coder-gpu: scope-aware identifier MASKED generation on the t27
    # bench via tc_fast --step-io (see scripts/t27_gen_masked.py). Same 30
    # failed items as the feedback arm, so the three arms (plain / feedback
    # / masked) compare back-to-back. Env: MASK_VER (artifact version
    # suffix, default 3 -- v1/v2/v3 must NOT fold into one file), MASK_N,
    # MASK_THREADS, MASK_OFF=1 for the paired no-mask control,
    # MASK_KV_I8=1 for the int8 KV cache (faster, approximate -- the
    # token stream shifts, not comparable to f32-KV artifacts).
    IG=/Users/playra/igla-coder-gpu
    WT=/tmp/t27-bench
    /Library/Developer/CommandLineTools/usr/bin/git -C "$HOME/t27" worktree list \
      | grep -q "$WT" || /Library/Developer/CommandLineTools/usr/bin/git -C "$HOME/t27" \
        worktree add --detach "$WT" ef7781b5 >/dev/null
    cd "$IG" || exit 1
    # regression gate first: mask-rule changes must keep the gold replay
    # and the unit invariants green (t27_mask_check exits 1 otherwise)
