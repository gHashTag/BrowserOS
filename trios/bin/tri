    ;;

  # --- the continuous cycle -------------------------------------------------
  #
  # Added 2026-09-12, after the loop sat stopped for 147.9 hours. The driver
  # that ran iterations 1-96 was a Claude cron job scoped to a chat session; it
  # died with that session, and nothing on the dashboard distinguished "the
  # driver is scheduled" from "the launchd timers fired recently", so a dead
  # loop kept a green light. `cycle.mjs` is a plain file any scheduler can run.
  #
  # These arms sit at the END of the case on purpose. A shell `case` takes the
  # FIRST match, which is how `tri feed --act` reached an unrelated arm for its
  # whole life while a timer ran it every 300 seconds. Every word below was
  # checked against every arm above before insertion, and `tri cycle-doctor`
  # re-checks it on every run rather than trusting that check to stay true.

  cycle)
    # Measure, cross-examine, draw, record. Changes nothing else - see the cron
    # contract at the top of cycle.mjs. Exits 2 when anomalies were found, which
    # is the answer and not a failure.
    shift 2>/dev/null || true
    exec node /Users/playra/BrowserOS/trios/.trinity/loop/cycle.mjs "$@"
    ;;
  cycle-repair)
    # The same, plus the enumerated safe repairs: release a lock whose holder is
    # provably dead, and remove CLEAN worktrees when the volume is nearly full.
    # `git worktree remove` runs without --force, so a worktree holding unlanded
    # bee work refuses to go. That refusal is the point.
    shift 2>/dev/null || true
    exec node /Users/playra/BrowserOS/trios/.trinity/loop/cycle.mjs --repair "$@"
    ;;
  cycle-dash)
    f=/Users/playra/BrowserOS/trios/.trinity/loop/DASHBOARD2.ansi
    [ -f "$f" ] || { echo "no dashboard drawn yet - run: tri cycle"; exit 1; }
    # The age comes FIRST and comes from the filesystem, not from the file's own
    # header. The old DASHBOARD.txt advertised a live cron job for six days
    # after that job stopped existing; reading a dashboard without its age is
    # how that went unnoticed.
    echo "drawn $(( ( $(date +%s) - $(stat -f %m "$f") ) / 60 )) min ago"
    cat "$f"
    ;;
  cycle-html)
    # The wide dashboard. The terminal one is 74 columns and drops the
    # provenance the reading paid to measure; this one keeps all four fields per
    # metric and prints the repair line beside each anomaly.
    #
    # It exits 2 when the reading it drew is older than a cycle. That is not a
    # failure of the renderer and the page still gets written - it is the
    # renderer refusing to let a stale picture pass for a live one.
    shift 2>/dev/null || true
    node /Users/playra/BrowserOS/trios/.trinity/loop/dash-cc.mjs "$@"
    rc=$?
    case " $* " in *" --stdout "*) exit $rc ;; esac
    [ "${TRI_NO_OPEN:-}" = "1" ] || open /Users/playra/BrowserOS/trios/.trinity/loop/DASHBOARD.html
    exit $rc
    ;;
  cycle-anom|cycle-anomalies)
    # Every anomaly with its claim, its truth, and its repair - the dashboard
    # only has room for seven.
    exec node /Users/playra/BrowserOS/trios/.trinity/loop/anomaly.mjs "${2:-}"
    ;;
  cycle-sense)
    shift 2>/dev/null || true
    exec node /Users/playra/BrowserOS/trios/.trinity/loop/sense.mjs "$@"
    ;;
  cycle-log)
    tail -"${2:-12}" /Users/playra/BrowserOS/trios/.trinity/loop/cycle-ledger.jsonl 2>/dev/null \
      | python3 -c '
import sys, json
for line in sys.stdin:
    try: d = json.loads(line)
    except Exception: continue
    v = d.get("vitals", {})
    sev = d.get("severity", {})
    print("%4s  %s  %-7s %2d anomalies (%db/%dh)  iter %s stale %sh  bees %s  disk %s%%" % (
        d.get("cycle"), d.get("at","")[:19], d.get("mode",""), d.get("anomalies",0),
        sev.get("blocker",0), sev.get("high",0),
        v.get("iteration"), v.get("staleHours"), v.get("beesRunning"), v.get("diskPercent")))
    for r in d.get("repairs", []):
        print("        repaired: " + r.get("did",""))
'
    ;;
  cycle-note)
    # Prose is written, never generated. The dashboard renders whatever is in
    # cycle-notes.json and renders nothing when it is empty, rather than
    # inventing a summary of an iteration nobody described.
    #   tri cycle-note did  "what this iteration actually changed"
    #   tri cycle-note next "one of the three ways to continue"
    #   tri cycle-note clear
    [ -z "${2:-}" ] && { echo 'tri cycle-note did|next "text"   |   tri cycle-note clear'; exit 1; }
    python3 - "$2" "${3:-}" << 'PYNOTE'
import json, os, sys
p = "/Users/playra/BrowserOS/trios/.trinity/loop/cycle-notes.json"
kind, text = sys.argv[1], sys.argv[2]
try:
    d = json.load(open(p, encoding="utf-8"))
except Exception:
    d = {}
if kind == "clear":
    d = {"did": [], "next": []}
elif kind in ("did", "next"):
    if not text:
        sys.exit("tri cycle-note %s \"text\"" % kind)
    d.setdefault(kind, []).append(text)
else:
    sys.exit("kind must be did, next or clear")
json.dump(d, open(p, "w", encoding="utf-8"), ensure_ascii=False, indent=2)
print("%s: %d did, %d next" % (p, len(d.get("did", [])), len(d.get("next", []))))
PYNOTE
    ;;
  cycle-doctor)
    # Does the cycle still have everything it needs, and is every one of its own
    # commands still reachable? Run this before trusting a schedule.
    exec node /Users/playra/BrowserOS/trios/.trinity/loop/cycle-doctor.mjs "${2:-}"
    ;;
  driver)
    # IS ANYTHING FIRING AN ITERATION? The loop ran 96 of them and then stopped
    # for six days while every housekeeping timer went on writing, because the
    # thing that opened iterations was a session-scoped scheduled task that died
    # with its session and left nothing behind. Four live launchd timers say
    # NOTHING about whether an iteration will ever open again - they are
    # housekeeping - which is why this prints all three schedulers separately
    # instead of one reassuring total.
    #
    # THREE EXIT CODES, because two of them used to be one:
    #   0  a scheduled task exists
    #   1  MEASURED zero - the driver is gone
    #   2  scheduled_tasks.json did not parse into a shape this knows, so the
    #      answer is unknown. That used to be reported as zero, which is a
    #      confident red verdict assembled from a file nobody could read.
    exec node /Users/playra/BrowserOS/trios/.trinity/loop/driver.mjs "$@"
    ;;
  drift)
    # IS THE CLI THE TIMERS RUN THE CLI IN THE REPOSITORY? Until 2026-09-13 this
    # file - 1686 lines, the only entry point to the whole loop - existed in
    # exactly one place on this machine and in no repository at all, while four
    # launchd timers executed it by absolute path every 300 to 900 seconds. The
    # tracked copy lives at trios/bin/tri; this is the gate that says whether it
    # still describes what actually runs. Exit 1 = measured difference, exit 2 =
    # nothing could be read, which is NOT agreement.
    shift 2>/dev/null || true
    exec node /Users/playra/BrowserOS/trios/.trinity/loop/tri-drift.mjs "$@"
    ;;
  backlog)
    # What the backlog CONTAINS, read issue by issue rather than inferred from
    # the Queen's skip counts. On 2026-09-12: 590 open, 40 delegable, 24 briefs
    # one heading short, and 526 reports and free prose. The swarm is not
    # blocked by a parser - 89% of its food was written to record findings, and
    # a finding is not an instruction.
    shift 2>/dev/null || true
    exec node /Users/playra/BrowserOS/trios/.trinity/loop/backlog.mjs "$@"
    ;;

  learn)
    # Experience is saved as a FILE, and the index line is written only after
    # the file is on disk. On 2026-09-12 MEMORY.md had 183 pointers, and 101 of them
    # (55%) led to a file that did not exist: the pointer and the file were two separate
    # manual edits, and only one of them happened reliably. Here that order
    # is structural - this command cannot write a pointer without the file.
    #   tri learn --audit                     — which index entries point at nothing
    #   tri learn <slug> --hook "line" --desc "..." --body-file F [--type T]
    shift 2>/dev/null || true
    python3 - "$@" << 'PYLEARN'
import os, re, sys

MEM = "/Users/playra/.claude/projects/-Users-playra-BrowserOS/memory"
IDX = os.path.join(MEM, "MEMORY.md")
KINDS = ("user", "feedback", "project", "reference")
POINTER = re.compile(r"\]\(([a-z0-9][a-z0-9-]*\.md)\)")


def pointers():
    if not os.path.exists(IDX):
        return []
    out = []
    for n, line in enumerate(open(IDX, encoding="utf-8"), 1):
        m = POINTER.search(line)
        if m:
            out.append((n, m.group(1), line.rstrip("\n")))
    return out


def audit():
    pts = pointers()
    dead = [(n, t) for n, t, _ in pts if not os.path.exists(os.path.join(MEM, t))]
    on_disk = set(
        f for f in os.listdir(MEM) if f.endswith(".md") and f != "MEMORY.md"
    )
    indexed = set(t for _, t, _ in pts)
    # A file reached only through a [[link]] in another memory is indexed enough.
    linked = set()
    for f in on_disk:
        body = open(os.path.join(MEM, f), encoding="utf-8", errors="replace").read()
        for name in re.findall(r"\[\[([a-z0-9][a-z0-9-]*)\]\]", body):
            linked.add(name + ".md")
    orphan = sorted(on_disk - indexed - linked)
    print("pointers in MEMORY.md   : %d" % len(pts))
    print("resolve to a real file  : %d" % (len(pts) - len(dead)))
    print("dangling                : %d" % len(dead))
    print("files on disk           : %d" % len(on_disk))
    print("on disk, unreachable    : %d" % len(orphan))
    for n, t in dead:
        print("  dangling  MEMORY.md:%-4d %s" % (n, t))
    for f in orphan:
        print("  unreachable          %s" % f)
    if not dead and not orphan:
        print("\nindex and disk agree")
        return 0
    print(
        "\nA dangling pointer is not harmless: the one line of prose after the dash"
        "\nis then the whole memory, while the link advertises a document behind it."
    )
    return 2


args = sys.argv[1:]
if not args or args[0] in ("-h", "--help"):
    print('tri learn --audit')
    print('tri learn <slug> --hook "index line" --desc "..." --body-file F [--type feedback]')
    sys.exit(1)
if args[0] == "--audit":
    sys.exit(audit())

slug = args[0]
opt = {}
i = 1
while i < len(args):
    if args[i].startswith("--") and i + 1 < len(args):
        opt[args[i][2:]] = args[i + 1]
        i += 2
    else:
        sys.exit("unknown argument: %s" % args[i])

if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", slug):
    sys.exit("slug must be kebab-case ascii: %s" % slug)
kind = opt.get("type", "project")
if kind not in KINDS:
    sys.exit("--type must be one of: %s" % ", ".join(KINDS))
for need in ("hook", "desc"):
    if not opt.get(need):
        sys.exit("--%s is required: the index is unreadable without it" % need)
bf = opt.get("body-file")
if not bf:
    sys.exit("--body-file is required: a memory body is written, not generated")
if not os.path.exists(bf):
    sys.exit("no such file: %s" % bf)
body = open(bf, encoding="utf-8").read().strip()
if not body:
    sys.exit("empty body: %s" % bf)

path = os.path.join(MEM, slug + ".md")
existed = os.path.exists(path)
desc = opt["desc"].replace('"', "'")
with open(path, "w", encoding="utf-8") as fh:
    fh.write("---\nname: %s\ndescription: \"%s\"\nmetadata:\n  type: %s\n---\n\n%s\n"
             % (slug, desc, kind, body))

# Only now - the pointer. And only if it is not there yet.
line = "- [%s](%s.md) — %s" % (opt.get("title", slug), slug, opt["hook"])
have = [t for _, t, _ in pointers()]
if slug + ".md" in have:
    print("%s: %s" % ("rewritten" if existed else "created", path))
    print("pointer already in MEMORY.md, not duplicating")
else:
    with open(IDX, "a", encoding="utf-8") as fh:
        fh.write(line + "\n")
    print("created: %s" % path)
    print("added to index: %s" % line)
PYLEARN
    ;;
  skills)
    # What is on disk as a skill - and which skills have no SKILL.md of their
    # own, i.e. the directory name exists but the instructions do not. This is NOT the answer to
    # "which skills does the Queen see": her access is measured on the wire,
    # not in the filesystem (WAVE-066: she reached 4 of 26).
    python3 - "${2:-}" << 'PYSKILLS'
import os, sys

ROOTS = [
    ("project ", "/Users/playra/BrowserOS/trios/.claude/skills"),
    ("personal", os.path.expanduser("~/.claude/skills")),
    ("library ", os.path.expanduser("~/skills")),
]
want = (sys.argv[1] if len(sys.argv) > 1 else "").strip()
total = broken = 0
for label, root in ROOTS:
    if not os.path.isdir(root):
        print("%s  %s  — no directory" % (label, root))
        continue
    # `.git`, `_state`, `_archive` and other scaffolding are not skill directories.
    # Without this line the first run of the command reported 8 findings, of which
    # only one was real: a tool that counts noise as findings is the very
    # defect this loop exists to fix.
    names = sorted(
        d
        for d in os.listdir(root)
        if os.path.isdir(os.path.join(root, d)) and not d.startswith((".", "_"))
    )
    print("\n%s  %s  (%d)" % (label, root, len(names)))
    for n in names:
        if want and want not in n:
            continue
        sk = os.path.join(root, n, "SKILL.md")
        total += 1
        if os.path.exists(sk):
            size = os.path.getsize(sk)
            head = ""
            for line in open(sk, encoding="utf-8", errors="replace"):
                if line.startswith("description:"):
                    head = line.split(":", 1)[1].strip().strip('"')[:70]
                    break
            print("  %-34s %6d b  %s" % (n, size, head))
        else:
            broken += 1
            print("  %-34s      -  NO SKILL.md" % n)
print("\ndirectories total: %d, without SKILL.md: %d" % (total, broken))
sys.exit(2 if broken else 0)
PYSKILLS
    ;;
  proof)
    # Does a document refer to things that exist. claim-guard once gave
    # a green light to a typo in a file name: the path was quoted, the file did not
    # exist, and nobody asked the disk. Here the disk is asked.
    #   tri proof <file.md> [...]      — exit 2 if any path is not found
    [ -z "${2:-}" ] && { echo 'tri proof <file.md> [...]'; exit 1; }
    shift 2>/dev/null || true
    python3 - "$@" << 'PYPROOF'
import os, re, subprocess, sys

REPO = "/Users/playra/BrowserOS"
CODE = re.compile(r"`([^`\n]{2,160})`")
LOOKS_PATH = re.compile(r"^[~./A-Za-z0-9_-][A-Za-z0-9_./~*-]*$")
# Extensions that files in this tree really have. Without this
# list `ProjectPaths.trinity` (a property access in Swift) reads as a path
# and lands in the report as not found - an accusation nobody made.
EXTS = {
    ".md", ".mjs", ".js", ".ts", ".tsx", ".json", ".jsonl", ".swift", ".sh",
    ".py", ".rs", ".toml", ".yml", ".yaml", ".t27", ".zig", ".c", ".h", ".v",
    ".plist", ".txt", ".ansi", ".lock", ".app", ".png", ".svg", ".log", ".env",
}

# A path in a document is relative not to the current directory but, most often, to the
# document's own directory or the tree root. In 2026-07 a report declared 15 dead links,
# and all 15 were alive - they were just measured from the wrong root. Here we ask
# git: it knows the real set of paths.
try:
    tracked = set(
        subprocess.run(
            ["git", "-C", REPO, "ls-files"],
            capture_output=True, text=True, timeout=60, check=True,
        ).stdout.split("\n")
    ) - {""}
except Exception as e:
    print("git ls-files did not answer (%s) - checking the filesystem only" % e)
    tracked = set()
by_base = {}
for t in tracked:
    by_base.setdefault(os.path.basename(t), []).append(t)


def resolves(cand, docdir):
    exp = os.path.expanduser(cand)
    if os.path.isabs(exp):
        return os.path.exists(exp)
    roots = [docdir, REPO, os.getcwd()]
    # ...and every directory between the document and the tree root.
    d = docdir
    while d.startswith(REPO) and d != REPO:
        d = os.path.dirname(d)
        roots.append(d)
    if any(os.path.exists(os.path.join(r, exp)) for r in roots):
        return True
    if cand in tracked or any(t.endswith("/" + cand) for t in tracked):
        return True
    if "/" not in cand and cand in by_base:
        return True
    if "*" in cand:                      # `.worktrees/*/trios` - check the trunk
        stem = cand.split("*")[0].rstrip("/")
        return bool(stem) and any(os.path.exists(os.path.join(r, stem)) for r in roots)
    return False


bad = checked = 0
for doc in sys.argv[1:]:
    if not os.path.exists(doc):
        print("NO DOCUMENT  %s" % doc)
        bad += 1
        continue
    docdir = os.path.dirname(os.path.abspath(doc))
    text = open(doc, encoding="utf-8", errors="replace").read()
    seen, misses = set(), []
    for raw in CODE.findall(text):
        cand = raw.split(":")[0].strip().rstrip(".,;")
        if cand in seen or not LOOKS_PATH.match(cand):
            continue
        ext = os.path.splitext(cand)[1].lower()
        if "/" not in cand and ext not in EXTS:
            continue                     # a single word is not a path
        if "/" in cand and ext and ext not in EXTS and not cand.endswith("/"):
            pass                         # a dotted directory name is still a path
        seen.add(cand)
        checked += 1
        if not resolves(cand, docdir):
            misses.append(cand)
    print("\n%s — paths %d, not found %d" % (doc, len(seen), len(misses)))
    for m in misses:
        print("  NOT FOUND  %s" % m)
    bad += len(misses)
print("\npaths checked: %d, not found: %d" % (checked, bad))
print("(roots: the document directory, every directory up to the tree root, and git ls-files)")
sys.exit(2 if bad else 0)
PYPROOF
    ;;

  # --- loop tools that had no entry point (2026-09-13) --------------------
  #
  # The 2026-09-13 audit found two classes here: a tool written but not
  # wired to any arm (judge-calibration.mjs and dash2.mjs, 27 KB between
  # them, zero importers), and an arm with no line in `tri help` (23 of 146). Both
  # arms below were added TOGETHER with their help lines in one pass:
  # an undocumented arm is exactly the second of these two defects.
  #
  # The names were checked against every label above before insertion: `case` takes the FIRST
  # match, and that is exactly how `tri feed --act` landed in someone else's
  # arm all its life. `board`, `lesson`, `status`, `wave` are taken and mean something else —
  # hence `which-board`, `loop-lesson`, `wave-plan` here.

  which-board)
