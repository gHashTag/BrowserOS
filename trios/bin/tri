    ;;
  tc-soundness)
    # igla-coder-gpu: mask SOUNDNESS over a remote taxonomy dump -- every
    # `undeclared identifier` death on a declare-rule arm (m*) is a mask
    # defect or a known gap: glued_decl / static_leak / body_keyword /
    # in_body / type_core / truncated / value_core / other. Light, local.
    #   tri tc-soundness [rows.jsonl cands.jsonl]   (default: arena champion)
    #   tri tc-soundness ab [tag ...]               baseline vs final_tuned_<tag>
    #                                               (default tags: m12 m13)
    # Rows come from t27_error_taxonomy.py --dump (run it via tri tc-remote).
    IG=/Users/playra/igla-coder-gpu
    cd "$IG" || exit 1
    shift
    if [ "${1:-}" = "ab" ]; then
      shift
      tags=("$@"); [ ${#tags[@]} -eq 0 ] && tags=(m12 m13)
