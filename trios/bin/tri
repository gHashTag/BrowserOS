    #   tri tc-cathead [--judge <judge_passes.jsonl>] [run ...]
    shift; cd /Users/playra/igla-coder-gpu && exec python3 scripts/t27_cat_headline.py "$@"
    ;;
  tc-disc)
    # igla-coder-gpu: paired A/B readout -- EXACT per-item discordants
    # (splice-audited), compute contract counters, chars/sample.
    #   tri tc-disc <base_run> <run> [run ...]     (names under results/t27/)
    #   catalog runs: tri tc-disc catalog/sc_tuned catalog/sc_cpu_b_s1 (own items+tree; exact McNemar)
    cd /Users/playra/igla-coder-gpu || exit 1
    shift
    python3 scripts/t27_disc.py "$@"
    ;;
  tc-loop)
    # igla-coder-gpu: the improvement loop's first command every iteration.
    # Live selfcheck runs + progress, finished/dead/untracked results dirs,
    # log Tracebacks, mask-edited-mid-run, journal tail. Exit 1 = anomaly.
    #   tri tc-loop                    # status + anomalies
    #   tri tc-loop run <out> K=V ...  # lock-guarded background selfcheck
    #                                  # (REFUSES while another is live)
    #   tri tc-loop chain "<out> K=V" "<out2> K=V"  # queue, one at a time,
    #                                  # each waits on guard (use nohup)
    #   tri tc-loop guard              # exit 1 if a run is live (before
    #                                  # editing t27_gen_masked.py!)
    cd /Users/playra/igla-coder-gpu || exit 1
    shift
    python3 scripts/tc_loop.py "${@:-status}"
    ;;
  tc-curve)
    # igla-coder-gpu: compare two selfcheck runs' budget curves from RAW
    # results.jsonl under ONE fixed definition (pass-union / past-parser-
    # union). NEVER compare summary.json curves across runs -- they were
    # built under different definitions (2026-09-30: a strict1 summary
    # said compile@1=68, raw rows give 253; a "3.7x jump" claim died only
    # at recomputation).
    #   tri tc-curve <dirA> <dirB> [budgets=1,2,3,5,10,15]
    cd /Users/playra/igla-coder-gpu || exit 1
    python3 scripts/t27_curve_cmp.py "$2" "$3" ${4:+--budgets "$4"}
    ;;
  tc-pair)
    # igla-coder-gpu: PAIRED A/B of two selfcheck arms at one seed -- the
    # causal protocol (skill paired-ab-tiny-model; without SC_SEED a
    # 30-item pass count is NOISE, see research/REPAIR_BODY_2026-09-29.md).
    #   tri tc-pair <SEED> [BUDGET=15] [ITEMS=30]
    # Env: PAIR_A / PAIR_B = env-string for arm B's EXTRA knobs, e.g.
    #   PAIR_B="SC_REPAIR=1"        (treatment: repair on)
    #   PAIR_B="SC_EARLY=1"         (treatment: early abort)
    #   PAIR_B="SC_PROBE=1 SC_REDRAW=3"  (probe abort + kill-and-restart)
    # Arm A is always the bare base. Both arms get SC_SEED, same rounds,
    # same items; output dirs results/t27/pair<SEED>_{a,b}. Prints the
    # summary diff + paired-body identity count (0 unexplained = causal).
    IG=/Users/playra/igla-coder-gpu
    cd "$IG" || exit 1
    SEED="${2:?usage: tri tc-pair <SEED> [BUDGET=15] [ITEMS=30]}"
    BUD="${3:-15}"; N="${4:-30}"
    for arm in a b; do
      KNOBS=""; [ "$arm" = b ] && KNOBS="${PAIR_B:-}"
      eval "env SC_OUT=results/t27/pair${SEED}_${arm} SC_ROUNDS=$BUD \
        SC_ITEMS=$N SC_SEED=$SEED $KNOBS tri tc-t27selfcheck" \
        || exit 1
    done
    python3 - "$SEED" <<'PYEOF'
import json, sys
seed = sys.argv[1]
sa = json.load(open(f"results/t27/pair{seed}_a/summary.json"))
sb = json.load(open(f"results/t27/pair{seed}_b/summary.json"))
for k in ("items", "samples", "resolved_pass", "resolved_compile"):
    d = "" if sa[k] == sb[k] else "   <-- DELTA"
    print(f"{k:18s} A {sa[k]:>5}   B {sb[k]:>5}{d}")
ra = {json.loads(l)["id"]: json.loads(l)["status"]
      for l in open(f"results/t27/pair{seed}_a/results.jsonl")}
rb = {json.loads(l)["id"]: json.loads(l)["status"]
      for l in open(f"results/t27/pair{seed}_b/results.jsonl")}
diff = [i for i in set(ra) & set(rb) if ra[i] != rb[i]]
print(f"item status diffs: {len(diff)}")
for i in diff[:10]: print(f"  {i}: {ra[i]} -> {rb[i]}")
ba = {(r["id"], r["round"], r["k"]): r["body"]
      for l in open(f"results/t27/pair{seed}_a/cands.jsonl")
      for r in ([json.loads(l)] if '"body"' in l else [])}
bb = {(r["id"], r["round"], r["k"]): r["body"]
      for l in open(f"results/t27/pair{seed}_b/cands.jsonl")
      for r in ([json.loads(l)] if '"body"' in l else [])}
common = set(ba) & set(bb)
same = sum(1 for k in common if ba[k] == bb[k])
print(f"paired bodies: {len(common)} common, {same} identical, "
      f"{len(common)-same} differ (treatment transform)")
PYEOF
    ;;
  tc-taxonomy)
    # igla-coder-gpu: one-command failure taxonomy over mask artifacts --
    # BOTH halves of the failure mass in one run:
    #   blocked_compile -> scripts/t27_error_taxonomy.py (first zig error:
    #     undeclared 65%, type 12.5%, ...)
    #   blocked_codegen -> scripts/t27_codegen_taxonomy.py (t27 parser:
    #     module keywords in body 30%, brace imbalance 50%, unterminated
    #     strings 9%; see research/REPAIR_BODY_2026-09-29.md)
    # Defaults to the committed v1/v2/v3 sets; TX_SAMPLE caps each run
    # (0 = all codegen; the compile script has its own --sample default 120).
    IG=/Users/playra/igla-coder-gpu
    cd "$IG" || exit 1
    T27=${TX_T27:-/tmp/t27-bench}
    T27C=${TX_T27C:-/tmp/t27c-build/target/release/t27c}
    CANDS=${TX_CANDS:-"results/t27/masked_tc.jsonl results/t27/masked2_tc.jsonl results/t27/masked3_tc.jsonl"}
    CHECKS=${TX_CHECKS:-"results/t27/check_masked/results.jsonl results/t27/check_masked2/results.jsonl results/t27/check_masked3/results.jsonl"}
    [ -d "$T27" ] && [ -x "$T27C" ] || { echo "need $T27 and $T27C (tri tc-t27bench sets them up)"; exit 1; }
    echo "== blocked_compile (zig stage, first error) =="
    python3 scripts/t27_error_taxonomy.py \
      --cands results/t27/masked_tc.jsonl --check results/t27/check_masked/results.jsonl \
      --items t27/items.jsonl --t27 "$T27" --t27c "$T27C" \
      --sample "${TX_SAMPLE_COMPILE:-120}" --workers "${TX_WORKERS:-4}"
    echo "== blocked_codegen (t27 parser stage) =="
    python3 scripts/t27_codegen_taxonomy.py \
      --cands $CANDS --check $CHECKS \
      --items t27/items.jsonl --t27 "$T27" --t27c "$T27C" \
      --sample "${TX_SAMPLE:-0}" --workers "${TX_WORKERS:-4}" \
      --out "${TX_OUT:-/tmp/codegen_taxonomy.json}"
    ;;
  tc-maskcheck)
    # igla-coder-gpu: the mask gate. Default = unit battery only (seconds,
    # safe while the MacBook is loaded); --full adds the gold replay (~6 min
    # single core; the remote arena job runs it as its first line anyway).
    #   tri tc-maskcheck [--full] [--mask-src <old mask>]   (negative control)
    IG=/Users/playra/igla-coder-gpu
    cd "$IG" || exit 1
    shift
    if [ "${1:-}" = "--full" ]; then shift; set -- "$@"; else set -- --units-only "$@"; fi
    nice python3 scripts/t27_mask_check.py --t27 /tmp/t27-bench \
      --tokenizer results/data8k/tokenizer.json "$@" | grep -v '^OK'
    exit "${PIPESTATUS[0]}"
    ;;
  tc-gpuft)
    # igla-coder-gpu: the B fine-tune on a RunPod 4090 (remote/gpu_ft.sh: 5 arms
    # in ~12 min + the catalog judge on the pod, ~25 min/model). Loop 25.
    #   tri tc-gpuft up|status|collect [pod name, default gpuft]
    # up/collect read the balance (log both in LEDGER.md); pod self-stops.
    #   JOB=gpu_ft2 GPU="NVIDIA L4,NVIDIA RTX PRO 4000 Blackwell" tri tc-gpuft up gpuft2
    # JOB picks remote/<JOB>.sh (loop 26: param gate + --fim-logic arms, see
