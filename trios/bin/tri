  lesson-orphans)
    # Which loop lessons reached NOT A SINGLE skill. A lesson lives in
    # state.json and is read only by whoever opens state.json; a skill
    # loads itself. On 2026-09-13 a measurement found seven such lessons.
    #
    # WHAT EXACTLY IS MEASURED, and why it is an UPPER BOUND, not a verdict:
    # a match is a verbatim six-word window (step 3; normalisation is
    # lower case, everything except letters and digits becomes a space). A lesson retold in
    # a skill in OTHER words will look like an orphan here. In a manual
    # check on 2026-09-13, four of eleven zeros turned out to be stated in
    # queen-swarm-unblock in other words — so the list must be read through
    # by eye, not taken as a verdict.
    #   tri lesson-orphans [--all]   (--all: + ~/skills and ~/.claude/skills)
    # Exit 2 = orphans found. That is an answer, not a failure.
    shift 2>/dev/null || true
    python3 - "$@" << 'PYORPHAN'
import json, os, re, sys

STATE = "/Users/playra/BrowserOS/trios/.trinity/loop/state.json"
ROOTS = ["/Users/playra/BrowserOS/trios/.claude/skills"]
if "--all" in sys.argv[1:]:
    ROOTS += [os.path.expanduser("~/skills"), os.path.expanduser("~/.claude/skills")]

WORD = re.compile(r"[^a-z0-9]+")
N, STEP = 6, 3


def shingles(text, step=STEP):
    w = [x for x in WORD.sub(" ", text.lower()).split() if x]
    return [" ".join(w[i:i + N]) for i in range(0, max(0, len(w) - N + 1), step)]


try:
    state = json.load(open(STATE, encoding="utf-8"))
except Exception as e:
    sys.exit("state.json unreadable: %s" % e)
lessons = state.get("lessons") or []
if not lessons:
    sys.exit("state.json has no lessons — so there can be no orphans")

# Skill corpus: EVERY six-word window, step 1, otherwise window alignment
# would decide instead of the content.
corpus, files = {}, []
for root in ROOTS:
    if not os.path.isdir(root):
        print("no directory: %s" % root)
        continue
    for dirpath, _dirs, names in os.walk(root):
        for n in names:
            if not n.endswith(".md"):
                continue
            p = os.path.join(dirpath, n)
            files.append(p)
            try:
                body = open(p, encoding="utf-8", errors="replace").read()
            except Exception:
                continue
            for sh in shingles(body, step=1):
                corpus.setdefault(sh, p)

orphans = []
rows = []
for i, les in enumerate(lessons, 1):
    text = (les.get("text") or "").strip()
    sh = shingles(text)
    if not sh:
        continue
    hits = [corpus[s] for s in sh if s in corpus]
    score = len(hits) / len(sh)
    best = max(set(hits), key=hits.count) if hits else None
    rows.append((i, les.get("iteration"), score, best, text))
    if not hits:
        orphans.append((i, les.get("iteration"), text))

print("lessons in state.json   : %d" % len(lessons))
print("skill files read        : %d" % len(files))
for r in ROOTS:
    print("  root: %s" % r)
print("with no shared window   : %d" % len(orphans))
print()
for i, it, text in orphans:
    print("  L%-3d iteration %-4s %s" % (i, it, text[:96].replace("\n", " ")))
if rows:
    rows.sort(key=lambda r: r[2])
    print("\nclosest to zero but not zero (for calibrating the threshold):")
    for i, it, score, best, text in [r for r in rows if r[2] > 0][:5]:
        print("  L%-3d %.2f  %s" % (i, score, os.path.basename(os.path.dirname(best or "")) or "?"))
print(
    "\nThis is an UPPER BOUND: a match here is verbatim (a six-word window),"
    "\nand a skill can state a lesson in other words. Read the list through by eye."
)
sys.exit(2 if orphans else 0)
PYORPHAN
    ;;
