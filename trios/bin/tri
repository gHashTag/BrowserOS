    railway variables --kv 2>/dev/null | grep -E "^(BOT_TOKEN|DATABASE_URL)=" | sed -E "s/^(BOT_TOKEN=.{8}).*/\1…/; s#(postgresql://[^:]+:)[^@]+@#\1***@#"
    echo "== migrations (woody=84 ours, woody_client=76 theirs) =="
    PGURL=$(railway variables -s postgres --kv 2>/dev/null | grep "^DATABASE_PUBLIC_URL=" | cut -d= -f2-)
    if [ -n "$PGURL" ]; then
      for db in woody woody_client; do
        echo -n "$db: "
        psql "${PGURL%/*}/$db" -t -A -c "SELECT count(*) FROM _schema_migrations" 2>/dev/null || echo "ERR"
      done
    else
      echo "postgres has no DATABASE_PUBLIC_URL — skipping"
    fi
    echo "== foreign service (/health only) =="
    echo -n "woody-weed-bot: "; curl -s -m 8 -o /dev/null -w "%{http_code}\n" https://woody-weed-bot-production-370f.up.railway.app/health
    ;;

  *)
    echo "unknown command: $1 (tri help)"; exit 1
    ;;
esac
