#!/usr/bin/env bash

# EDITED IN PLACE WHILE A TIMER MAY BE RUNNING IT.
# A launchd timer read this file mid-write on 2026-09-05 and bash reported a
# syntax error on a line that was, and is, correct - it had simply seen a
# truncated file, because open(path,'w') truncates before it writes.
# Edits to this file are written to a temp file and renamed.
# tri — Trinity S³AI ops CLI. Default (no arguments) is the old behaviour:
# railway ssh → claude. Subcommands run locally and speed up the loop.
set -uo pipefail
REPO="$HOME/999-multibots-telegraf"
KEY_HELP='key: railway variables list -s vibee-render -e production --kv | grep ^AGENT_KEYS= | cut -d= -f2- (take the first key, up to ":")'

case "${1:-}" in
  ""|ssh)
    # the old path, unchanged
    railway link -p reasonable-perception -e production > /dev/null 2>&1
    railway service link opencode > /dev/null 2>&1
    exec railway ssh -- bash -lc 'claude --dangerously-skip-permissions'
    ;;
  status)
    echo "== render health =="; curl -s -m 5 http://127.0.0.1:3333/health || echo "RENDER DOWN"
    echo; echo "== player =="; curl -s -m 5 -o /dev/null -w "5174:%{http_code}\n" http://localhost:5174/ 2>/dev/null || echo "player down"
    echo; echo "== feed stats =="; curl -s -m 8 https://vibee-render-production.up.railway.app/api/feed/stats 2>/dev/null | head -c 300
    echo; echo "== loop state =="; cat "$REPO/loop/state.json" 2>/dev/null
    echo; echo "== latest iterations =="; tail -5 "$REPO/loop/LOOP_STATE.md" 2>/dev/null
    ;;
  regress)
    bash "$REPO/loop/regression-check.sh"
    ;;
  morning)
    cat "$REPO/loop/MORNING.md" 2>/dev/null || echo "no MORNING.md — run morning-summary.ts"
    ;;
  loop)
    tail -60 "$REPO/loop/LOOP_REPORT.md" 2>/dev/null
    ;;
  vibee-feed)
    # RENAMED from `feed` on 2026-09-05. It shadowed the loop's own `feed` for
    # its whole life: a shell `case` takes the FIRST match, so `tri feed --act`
    # - which a launchd timer has been running every 300 seconds - reached this
    # content feed and never the loop step it was written for. The loop's feed
    # had never once run from its timer.
    curl -s -m 8 "https://vibee-render-production.up.railway.app/api/feed?limit=${2:-5}" \
      | python3 -c "import sys,json; d=json.load(sys.stdin); [print(t['id'], t.get('name','')[:50], '| ⭐', t.get('starsCount',0), '| 👁', t.get('viewsCount',0)) for t in d.get('templates',[])]" 2>/dev/null \
      || echo "feed unavailable"
    ;;
  chat)
    shift
    KEY=$(railway variables list -s vibee-render -e production --kv 2>/dev/null | grep ^AGENT_KEYS= | cut -d= -f2- | cut -d, -f1 | cut -d: -f1)
    if [ -z "$KEY" ] || [ -z "${1:-}" ]; then echo "text required: tri chat \"question\"; $KEY_HELP"; exit 1; fi
    curl -sN -m 120 https://vibee-render-production.up.railway.app/api/agent/chat \
      -H "X-Agent-Key: $KEY" -H 'Content-Type: application/json' \
      -d "$(python3 -c 'import json,sys; print(json.dumps({"messages":[{"role":"user","content":sys.argv[1]}]}))' "$*")" \
      | python3 -c "
import sys, json
for line in sys.stdin:
    try: ev = json.loads(line)
    except: continue
    if ev.get('тип') == 'текст': print(ev['текст'], end='')
    elif ev.get('тип') == 'результат': print(f\"  [{ev['имя']} · {ev['мс']}ms]\", file=sys.stderr)
print()
"
    ;;
  handover)
    # THE OWNER SUMMARY IS READ, NOT REMEMBERED.
    #
    # A heredoc frozen at wave 116 used to sit here, and it printed the state
    # of fourteen waves ago as current: the tree was at 130 while the first line
    # said "wave 116". Nothing could notice it — the arm was not even
    # mentioned in `tri help`. Fix of 2026-09-13: the source is now the same as for
    # `tri next` — the newest trios/.trinity/wave-loop-*.md — and the first line
    # printed is the file's AGE, taken from the filesystem. A week-old summary
    # must not look like today's.
    #
    # It prints the start of the wave (what it is about) and its tail with the options;
    # the middle is in `tri wave-plan`, the whole wave.
    T=/Users/playra/BrowserOS/trios
    w=$(ls "$T/.trinity"/wave-loop-*.md 2>/dev/null | sort | tail -1)
    [ -z "$w" ] && { echo "no wave found in $T/.trinity/wave-loop-*.md"; exit 1; }
    total=$(ls "$T/.trinity"/wave-loop-*.md 2>/dev/null | wc -l | tr -d ' ')
    age=$(( ( $(date +%s) - $(stat -f %m "$w") ) / 3600 ))
    echo "OWNER SUMMARY — from $w"
    echo "written ${age} h ago; waves on disk: $total"
    echo
    # A HEADING, NOT A WORD. The first version of this line searched for the
    # Russian word for "options" anywhere, and this tree has a line about an
    # "invariant" whose Russian spelling contains that word. So we match a
    # HEADING line (`^#`) and the full phrase the waves use to name their
    # tail, in both languages the waves are written in.
    opt=$(grep -n -m1 -E '^#{1,6} .*([Oo]ptions for the next wave|вариант(а|ы|ов) (сотрудничества|на следующую))' "$w" | cut -d: -f1)
    nlines=$(wc -l < "$w" | tr -d ' ')
    head_end=40
    if [ -n "$opt" ] && [ "$opt" -le 41 ]; then head_end=$((opt-1)); fi
    [ "$head_end" -ge 1 ] && sed -n "1,${head_end}p" "$w"
    if [ -n "$opt" ]; then
      [ "$opt" -gt $((head_end+1)) ] && echo "…(middle skipped — whole wave: tri wave-plan)"
      echo
      sed -n "${opt},\$p" "$w"
    elif [ "$nlines" -gt "$head_end" ]; then
      echo "…(another $((nlines-head_end)) lines; this wave has no options heading — whole wave: tri wave-plan)"
    fi
    echo
    echo "(the prose above was written by the wave author, not generated here)"
    ;;
  handover-116-archived)
    # The frozen wave-116 summary, taken off `tri handover` on 2026-09-13. It
    # stays readable but no longer passes itself off as the current state: its
    # wave is named in the command name.
    cat <<'BRIEF'
WAVE 116 SUMMARY (ARCHIVE, NOT THE CURRENT STATE) — three open frontiers
(t27 split in two per measurement 5d837a855 — the mesh corpus and
the rings specs are DIFFERENT)

CLOSED OVER THE WEEKEND (by your fixes — both confirmed by this cycle):
- LOCK ANOMALY: it was a backtick in a `: "..."` comment (4d56070ef) —
  `make check` in backticks ran as command substitution. A flat
  make cassettes gives a verdict in ~2 min (it used to hang 26+ min).
  The workarounds (TRIOS_SKIP_LOCK and names) are dead history; yours to delete.
- PROVIDER KEY: the bee works in the container without a key (d26a4abfc)
  via openai-compatible + a loopback rehearsal (TRIOS_QUEEN_REHEARSAL,
  never a silent fallback when a live key exists). Dispatch ran 3×, in parallel.

OPEN:

1a. T27 GENERATOR — MESH CORPUS (submodule trios-mesh, your ~/t27):
    13 specs that do not build, 11 causes in t27c: the main class (9 specs) —
    array parameters emitted without mut; one patch closes 6+.
    Map: wave-loop-098. Check after the fix: tri spec-diag.

1b. T27 — RINGS SPECS (rings/T27-00|01|02): t27c is NOT the blocker HERE —
    exit 0 + 121 lines of Rust for the decision core (measured 5d837a855).
    Missing: the T27-02 spec (Queen tick), the generated .rs,
    a host crate. can_start_another is duplicated in two languages
    (queen_core.t27:198 + QueenDelegation.swift:472) — today they
    agree; that is exactly the drift risk. The cloud bee CANNOT
    do this (the image has no Swift/Rust/t27c) — local only.

2. RELEASE REBUILD: the user's store has 0 fingerprints (the app predates
   the fix). The fix is proven live: fp 9d26541f, 8 reproductions
   (tri regression). One rebuild moves the number.

Also in flight: a fix for four cassettes (one cause, aa3b6fc14) — after
it a flat make cassettes should go green. The MVP architecture is now
in the repo (docs/architecture/, 6d1d50656) — the board quotes the internal copy.

ORACLE BROKEN (found by wave 120): the Swift e2e suite (make test /
make mutants) has not built since 12b97dedc — six rings files do
import QueenCore, while tests/swift/run_chat_sse_e2e.sh:91 builds rings
as one module. All 22 mutants are unscorable; the gate honestly fails closed,
it does not lie green. Cure: teach the script the QueenCore module (mind
the duplicate QueenSpecQuality.swift in rings vs queen-core).
FROM WAVE 125 THE SCRIPT ALSO BLOCKED THE LIVE PROTOCOL — CHAIN RESTORED
by the loop (waves 126-130): script fixed with the build.sh pattern, suite 972/972
green, the 22nd mutant caught, bundle rebuilt (the cp x x bug in build.sh
is fixed), ninth live-verify: verdict met, fp d3c1d66d (new hash —
the tree moved; the earlier 8 are 9d26541f). Left for the owner: reconcile
the module lists 11 vs 15, the library-evolution flag, and the post-bundle step
`swift test` fails (libQueenCore.a as an input — a leak of the module
build flags).
BRIEF
    ;;
  mutants-logic-refresh)
    # Wave 122: build.sh emits .trinity/build/QueenCore with the toolchain
    # it was started under; the clade-e2e suites compile with the default one.
    # The mismatch (6.0.3 vs 6.3.3) breaks mutants-logic at import.
    # Here: rebuild the artifact with the default toolchain (the call from
    # build.sh:607-613) and run the gate. DRY=1 only prints.
    T=/Users/playra/BrowserOS/trios; QC="$T/.trinity/build/QueenCore"
    CORE=(rings/SR-00/QueenSpecQuality rings/SR-00/QueenIssueBoundary \
      rings/SR-00/QueenBeeResult rings/SR-00/QueenBoundaryPaths \
      rings/SR-00/QueenEpics rings/SR-00/QueenEvidencePolicy \
      rings/SR-00/QueenLanguagePolicy rings/SR-00/QueenLocalisation \
      rings/SR-00/QueenMergeGate rings/SR-00/QueenMissionContract \
      rings/SR-00/QueenRetryPolicy rings/SR-00/QueenReviewDecision \
      rings/SR-00/QueenSelfAudit rings/SR-00/QueenSkillMatch \
      rings/SR-00/QueenT27Acceptance)
    cd "$T" || exit 1
    CUR=$(swift --version 2>/dev/null | head -1)
    MOD=$(strings "$QC/QueenCore.swiftmodule" 2>/dev/null | grep -m1 -o 'Swift 6[0-9.]*' || echo unknown)
    echo "toolchain: $CUR | module: ${MOD:-none}"
    if [ "${DRY:-0}" = 1 ]; then echo "DRY: would swiftc -emit-module ${CORE[*]}"; exit 0; fi
    FILES=(); for f in "${CORE[@]}"; do FILES+=("$T/$f.swift"); done
    mkdir -p "$QC"
    swiftc -parse-as-library -emit-module -emit-library -static \
      -module-name QueenCore -emit-module-path "$QC/QueenCore.swiftmodule" \
      -o "$QC/libQueenCore.a" "${FILES[@]}" 2>"$QC/err" \
      || { echo "[FAIL] module rebuild failed:"; head -4 "$QC/err"; exit 1; }
    echo "[OK] module rebuilt with the default toolchain"
    make -C "$T" mutants-logic
    ;;
  spec-diag)
    # Batch diagnosis of specs that do not build (wave 099): gen-rust + rustc,
    # one error class per spec. Rerun after t27 generator fixes.
    T=/Users/playra/BrowserOS/trios; T27C="$T/.trinity/t27c-build/release/t27c"
    L="${2:-$T/.trinity/wave-097-lowering.log}"
    D=$(mktemp -d /tmp/tri_specdiag.XXXXXX)
    for s in $(grep -oE "nocompile\] [a-z0-9_]+" "$L" 2>/dev/null | awk '{print $2}' | sort -u); do
      F=$(find "$T/rings" -name "$s.t27" | head -1); [ -z "$F" ] && { echo "$s => spec not found"; continue; }
      "$T27C" gen-rust "$F" > "$D/$s.txt" 2>/dev/null
      E=$(rustc --edition 2021 --crate-type lib --emit=metadata --out-dir "$D" "$D/$s.txt" 2>&1 \
        | grep -oE "error\[E[0-9]+\]|error: [a-z ]+" | sort | uniq -c | tr '\n' ' ')
      echo "$s => ${E:-OK}"
    done; rm -rf "$D"
    ;;
  regression)
    # Live loop regression (wave 095): board + locks + live-verify
    # in one command — the protocol's required minimum for a Queen wave.
    tri board; echo; tri locks; echo
    tri live-verify "${2:-}" "${3:-}" 2>&1 | tail -1
    ;;
  live-verify)
    # A live fingerprint in one run (wave 081 recipe): the chain
    # approve→delegate→verify via the test bundle env channel, then the store.
    T=/Users/playra/BrowserOS/trios
    ISSUE="${2:-gHashTag/trios#1286}"; CRIT="${3:-make check passes}"
    pkill -f "trios-test.app/Contents" 2>/dev/null; sleep 1
    ( cd "$T" && TRIOS_E2E_QUEEN_COMMAND="/approve $ISSUE;;/delegate $ISSUE queen-swift --paths docs --criteria $CRIT;;/verify $ISSUE $CRIT met" \
        ./trios-test.app/Contents/MacOS/trios > /tmp/tri_live_verify.log 2>&1 ) &
    echo "live run started (/tmp/tri_live_verify.log); store in ~75s:"
    sleep 75; pkill -f "trios-test.app/Contents" 2>/dev/null
    python3 -c "
import json
try:
    for t in json.load(open('$T/.trinity-test/state/queen_delegation.json')):
        print(t['id'][:8], t['state'], 'verdicts:', t.get('criterionVerdicts'), 'fp:', (t.get('treeStateFingerprint') or 'NONE')[:20])
except FileNotFoundError: print('store not created')"
    ;;
  selftest)
    echo "tri: ok"; command -v railway >/dev/null && echo "railway: ok" || echo "railway: MISSING"
    command -v python3 >/dev/null && echo "python3: ok"
    [ -d "$REPO/loop" ] && echo "loop dir: ok" || echo "loop dir: MISSING"
    ;;
  anomalies|anom)
    # Step 0 of a loop turn: what broke in production while I was away.
    node "$REPO/.claude/loop-opus/anomalies.mjs"
    ;;
  verify)
    # Whether someone else's merge overwrote the last edit (continuous-loop safety net).
    node "$REPO/.claude/loop-opus/verify-landed.mjs"
    ;;
  providers|prov)
    # Live provider status via the anomaly detector (the /api/providers/status route
    # is behind auth and a bare curl gets 401; anomalies.mjs fetches it correctly).
    node "$REPO/.claude/loop-opus/anomalies.mjs" 2>/dev/null \
      | sed -n '/Провайдеры/,/Конвейер/p' | sed '$d'
    echo "  (FAL/ElevenLabs — waiting for the owner; GLM works)"
    ;;
  lesson)
    # Quickly record a lesson in the loop tooling: tri lesson "title" "body"
    shift
    L="$REPO/.claude/loop-opus/LESSONS.md"
    if [ -z "${1:-}" ]; then echo "title required: tri lesson \"title\" [body]"; exit 1; fi
    { printf '\n## %s\n\n' "$1"; [ -n "${2:-}" ] && printf '%s\n' "$2"; } >> "$L"
    echo "written to $L"
    ;;
  dash)
    # Rebuild and show the production dashboard (measured by a run, not from memory).
    node "$REPO/scripts/dashboard.cjs" 2>/dev/null | tail -40 \
      || cat "$REPO/docs/dashboard/STATUS.md" 2>/dev/null
    ;;
  board)
    # trios dashboard: latest iteration + live STATUS.md measurements
    T=/Users/playra/BrowserOS/trios
    tail -1 "$T/.trinity/dashboard/iterations.jsonl" 2>/dev/null | python3 -c 'import json,sys
try:
    d=json.load(sys.stdin)
    print("iteration", d["iteration"], ":", d["title"])
    print("gate:", d.get("gate","?"))
except Exception as e: print("iterations.jsonl unreadable:", e)'
    echo; sed -n '/## Measured here/,/## How to update/p' "$T/.trinity/dashboard/STATUS.md" 2>/dev/null | head -25
    ;;
  wave)
    # Skeleton of the next wave: trios/.trinity/wave-loop-NNN.md
    T=/Users/playra/BrowserOS/trios
    n=$(ls "$T/.trinity"/wave-loop-*.md 2>/dev/null | sed 's/.*loop-0*//;s/\.md//' | sort -n | tail -1)
    next=$((10#${n:-0}+1)); f="$T/.trinity/wave-loop-$(printf '%03d' "$next").md"
    printf '# T27 Wave Loop - Plan WAVE-%03d\n\nDomain: \n\n## Audit - weak spots\n\n| ID | Weak spot | Evidence |\n|----|-----------|----------|\n\n## Competitor research\n\n- \n\n## Plan\n\n## Report\n\n## Three options for the next wave\n\n1. \n2. \n3. \n' "$next" > "$f" && echo "$f"
    ;;
  locks)
    # Who holds the shared trios locks right now
    for d in /tmp/trios_harness.lock /tmp/trios_e2e.lock; do
      if [ -e "$d/pid" ]; then o=$(cat "$d/pid" 2>/dev/null); echo "$d: pid=${o:-?} $(ps -p "$o" -o etime= 2>/dev/null || echo '(dead — the lock can be reclaimed)')"
      elif [ -d "$d" ]; then echo "$d: busy, no pid file"; else echo "$d: free"; fi
    done
    w=$(pgrep -f "Serialised against every other harness" 2>/dev/null | wc -l | tr -d ' ')
    echo "waiting for the cassette lock: $w process(es)"
    ;;
  next)
    # The three collaboration options from the latest wave
    T=/Users/playra/BrowserOS/trios
    w=$(ls "$T/.trinity"/wave-loop-*.md 2>/dev/null | sort | tail -1)
    echo "$w:"; sed -n '/[Oo]ptions for the next wave/,$p' "$w" 2>/dev/null || echo "no waves"
    ;;
  # ---- continuous improvement loop (added 2026-09-04) -----------------------
  # State, ledger and dashboard live in trios/.trinity/loop/. Every command
  # here READS or appends; none of them mutates the swarm or the repository.
  iter)
    node /Users/playra/BrowserOS/trios/.trinity/loop/loop.mjs status
    ;;
  iter-dash)
    node /Users/playra/BrowserOS/trios/.trinity/loop/loop.mjs dash
    ;;
  iter-log)
    node /Users/playra/BrowserOS/trios/.trinity/loop/loop.mjs ledger "${2:-20}"
    ;;
  iter-anchors)
    node /Users/playra/BrowserOS/trios/.trinity/loop/loop.mjs anchors
    ;;
  iter-render)
    # Measure the swarm, update the anchors and redraw the dashboard, in the one
    # order that makes the deltas true. Optional: --work <facts.json>.
    shift 2>/dev/null || true
    node /Users/playra/BrowserOS/trios/.trinity/loop/snapshot.mjs "$@"
    ;;
  iter-unlock)
    # Only after checking `tri iter` says the lock is stale. Taking a HELD lock
    # lets two cron fires write at once, which is the failure the lock exists for.
    node /Users/playra/BrowserOS/trios/.trinity/loop/loop.mjs unlock
    ;;
  swarm)
    # One line of live truth about the Queen. Measured, never remembered.
    curl -sS -m 15 https://trios-agent-server-production.up.railway.app/queen/status \
      | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{const j=JSON.parse(s),t=j.lastTick||{},d=j.dispatches||{};
console.log("running "+d.running+"  finished "+d.finished+"  |  "+(t.allowed?"DISPATCHED":t.refusal));
console.log("skips "+t.skippedCount+"  "+JSON.stringify(t.skipSummary||{}));})' 2>/dev/null \
      || echo "queen unreachable"
    ;;
  fence)
    # Which paths parked dispatches hold, and therefore which boundaries a new
    # issue must avoid. A parked dispatch never releases, so this is a fence.
    railway ssh --service trios-agent-server -- sh -c 'cd /app/apps/server && bun -e "
const {Pool}=require(\"pg\");const p=new Pool({connectionString:process.env.DATABASE_URL});
p.query(\"select d.issue, d.review_state, d.owned_paths from queen_dispatch d where d.finished_at is not null and (d.review_state is null or d.review_state in (%A,%B,%C)) order by d.issue\".replace(\"%A\",\"'\''wait'\''\").replace(\"%B\",\"'\''sendBack'\''\").replace(\"%C\",\"'\''escalate'\''\")).then(r=>{
const s=new Set();r.rows.forEach(x=>(x.owned_paths||[]).forEach(q=>s.add(q)));
console.log(\"parked dispatches: \"+r.rows.length+\"   paths they fence: \"+s.size);
[...s].sort().forEach(q=>console.log(\"  \"+q));process.exit(0)}).catch(e=>{console.log(\"ERR\",e.message);process.exit(1)})
"' 2>&1 | grep -v "Using SSH\|railway.json\|Migrate\|Existing"
    ;;
  fp-check)
    # Do the checkers accuse anything KNOWN GOOD? The corpus is real - briefs a
    # worker actually satisfied, source the tree actually ships - because all
    # six false accusations this loop shipped failed on real input while the
    # synthetic fixtures agreed with the checker that wrote them.
    node /Users/playra/BrowserOS/trios/.trinity/loop/fp-check.mjs "${2:-12}"
    ;;
  fields)
    # Fields a decision reads that its query may never select. A field that
    # never arrives is `undefined`, and `undefined ?? 0` is a number every
    # assertion about it will pass - which is how a retry ceiling bounded
    # nothing while reporting success.
    node /Users/playra/BrowserOS/trios/.trinity/loop/fields.mjs "${2:-}"
    ;;
  clocks)
    # Every clock a decision is keyed on, and whether anything rewrites it.
    # A valve keyed on a field the review sweep overwrites could never fire and
    # cost a six-hour swarm outage; this asks where else that class lives.
    node /Users/playra/BrowserOS/trios/.trinity/loop/clocks.mjs
    ;;
  trend)
    # A level is not a rate. claimed at 15 falling is a fence coming down;
    # claimed at 15 rising is one being rebuilt, and the number cannot tell
    # them apart. Reads the snapshot lines the loop already records.
    node /Users/playra/BrowserOS/trios/.trinity/loop/trend.mjs "${2:-6}"
    ;;
  loop-coverage)
    # Which loop tools have never actually DONE anything. The report path and
    # the act path are different code; a tool that has only ever reported is a
    # tool whose real work is unproven.
    node /Users/playra/BrowserOS/trios/.trinity/loop/coverage.mjs
    ;;
  needs-you)
    # The escalations addressed to a person that reach none. queen_report is
    # written by the tick and read by no route; this is the missing reader.
    shift 2>/dev/null || true
    node /Users/playra/BrowserOS/trios/.trinity/loop/needs-you.mjs "$@"
    ;;
  judge-packet)
    # Assemble what a judge needs for the briefs no mechanical check can reach.
    # The tool assembles; the model judges. Nothing here decides anything.
    shift 2>/dev/null || true
    node /Users/playra/BrowserOS/trios/.trinity/loop/judge-packet.mjs "$@"
    ;;
  unpark)
    # A retry ceiling reached without ANY criterion being judged. Measured
    # 2026-09-04: in five parked dispatches the count of unmet criteria was
    # exactly the count of verdict lines the worker omitted, so the whole retry
    # budget went on the shape of a report and the work was never assessed.
    # Releases only those; a criterion tested and failed keeps its count.
    shift 2>/dev/null || true
    node /Users/playra/BrowserOS/trios/.trinity/loop/unpark.mjs "$@"
    ;;
  stale-escalations)
    # An escalation whose stated CAUSE no longer reproduces. Not a timer: a
    # send-back is clock-released because its input can never change, while an
    # escalation names a claim about the world that can be measured again. It
    # asks the shipping Swift parser, never a copy, and never releases an issue
    # whose body asks for a person in its own words.
    shift 2>/dev/null || true
    node /Users/playra/BrowserOS/trios/.trinity/loop/stale-escalations.mjs "$@"
    ;;
  holds)
    # What the swarm currently holds, and whether any two dispatches claim one
    # file. Paths compare COMPONENT-WISE: rings/SR-0 is a string prefix of
    # rings/SR-00/Queen.swift and is not a directory containing it.
    node /Users/playra/BrowserOS/trios/.trinity/loop/disjoint.mjs
    ;;
  reap-local)
    # The LAPTOP fills too. `git worktree add` failed mid-checkout on
    # 2026-09-04 with "No space left on device" at 100% full, while reap.mjs
    # reported the container volume healthy - which it was. Removes only
    # worktrees whose HEAD is already in the base AND whose tree is clean;
    # never --force, and a dirty tree is somebody's unfinished thought.
    shift 2>/dev/null || true
    node /Users/playra/BrowserOS/trios/.trinity/loop/reap-local.mjs "$@"
    ;;
  land)
    # WORK THAT WAS FINISHED, ACCEPTED, CLOSED - AND NEVER IN THE BRANCH.
    # Measured 2026-09-04: 174 queen branches on the remote, FIVE contained in
    # the base, and all 169 others carrying a real diff. A closed issue whose
    # code is not in the branch is a false statement about the repository.
    # Merges only a closed issue's branch, only when merge-tree says it applies
    # cleanly, only into feat/queen-supervisor, bounded per run, never forcing
    # and never deleting - and it REFUSES to run again if the count did not move.
    shift 2>/dev/null || true
    node /Users/playra/BrowserOS/trios/.trinity/loop/land.mjs "$@"
    ;;
  why)
    # WHY IS THE SWARM IDLE. Asked four times in one night and answered by hand
    # each time, differently: the chain failing from its own timer, the refill
    # queued behind five audits, accepted work never closed so every boundary
    # stayed held, a detector corpus run dry, a full disk, a stuck lock. None is
    # guessable from "RUNNING 0", and several look identical from outside.
    # Checks the causes in the order that makes them true and stops at the first
    # that explains what is seen, with the evidence and the command to run.
    shift 2>/dev/null || true
    node /Users/playra/BrowserOS/trios/.trinity/loop/why.mjs "$@"
    ;;
  feed)
    # Just the three steps that decide whether a worker has anything to start:
