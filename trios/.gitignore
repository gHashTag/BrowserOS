.DS_Store
trios_app

# Generated Rust build artifacts
target/
Cargo.lock

# Git worktrees
.worktrees/

# Trinity generated state
.trinity/*.log
.trinity/logs/
.trinity/e2e/
.trinity/dev/
.trinity/rollback/
.trinity/run/
.trinity/snapshots/
.trinity/experience/**
!.trinity/experience/
!.trinity/experience/*.json
.trinity/clades/
.trinity/self-awareness.json
.trinity/events/
.trinity/claims/
.trinity/queue/
.trinity/*.pid

# Trinity runtime state (auto-generated)
.trinity/state/

# Incremental app build directory: objects, output file map, dependency graph
# and the per-variant build lock (.trinity/build/<variant>.lock).
.trinity/build/

# Test-harness state and the incremental e2e build directory
.trinity-test/

# The dev variant's Trinity state. Ignored here for the same reason
# .trinity-test/ is: it is per-variant runtime, not source.
.trinity-dev/

# t27c's cargo target directory. The compiler's sources live in another
# repository this one may not edit, so `make chain` builds it here instead -
# 694 MB of Rust build products that must never reach .git/objects.
.trinity/t27c-build/

# Golden chain: the generated Rust, the two binaries and the two output
# files are all rebuilt by `make chain` on every run. Committing the
# generated core.rs would create exactly the second copy of the rule that
# L0 exists to prevent. Only main.rs, twinsrc/ and README.md are source.
.trinity/goldenchain/core.rs
.trinity/goldenchain/ring
.trinity/goldenchain/twin
.trinity/goldenchain/*.out

# Tooling
lefthook.yml

# Built app bundle
trios.app/

# The dev variant's build output, 178 MB rewritten by every `make dev`.
# Never ignored when the dev/release split landed, so every Queen snapshot
# re-hashed and zlib-compressed all of it into .git/objects: 5.40s against
# 1.07s once the blobs exist. That delay is what pushed the #1117 wait past
# its budget (#1263), and it leaked unreferenced blobs on every delegation.
trios_dev_app
trios-dev.app/
Frameworks-dev/

# The test variant's trio, same story: the cassette harness rebuilds these
# on every `make cassettes` (build.sh:86-87,646), and they were never added
# here when the dev trio was - which is why 96 MB of build products polluted
# git status for weeks and every whole-tree snapshot paid for them.
trios_test_app
trios-test.app/
Frameworks-test/

# Archived prototypes (kept locally, not part of build)
.archive/

# SwiftPM build artifacts + local frameworks
.build/
Frameworks/
