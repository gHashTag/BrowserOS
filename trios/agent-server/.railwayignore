# The build context is sent to the daemon before anything runs, and this tree
# carries 2.2 GB of node_modules. Excluding them is not an optimisation, it is
# the difference between a build and a timeout.
node_modules
**/node_modules
dist
**/dist
build
**/build
.git
.turbo
*.log

# Secrets never enter an image. .env.example is the only one that may.
.env
.env.*
!.env.example

# Local state that means nothing in a container.
.trinity
.claude
coverage
**/*.tsbuildinfo
**/.DS_Store

# Test fixtures and recordings: large, and never executed in production.
**/tests/__fixtures__
**/cassettes
