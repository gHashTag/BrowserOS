; Vendored from gHashTag/t27 specs/queen/control.t27, git blob f3d610970ef94ce7ea29432bf5423e65801a6e6f (master).
; The scheduler contract: event kinds, fenced task leases, reconcile cadence. This copy is
; read by the vendored t27_compiler.wasm at runtime; nothing here is parsed with a regex.
; Refresh: scripts/sync-t27-specs.sh (T27_ROOT), then bun test tests/api/queen-control.test.ts
// SPDX-License-Identifier: Apache-2.0
; specs/queen/control.t27 -- the Queen's scheduler control layer: events wake her, leases fence every
; claim, a person can assign or cancel, and a small set of domain agents is reused across tasks
; (gHashTag/t27#6657, parent #6655). One home of these rules; nobody restates them. The runtime that
; moves work is the trios supervisor (gHashTag/BrowserOS, trios/agent-server), whose lifecycle is the
; canonical task machine of specs/queen/dispatch.t27; the Inngest app of
; specs/automation/inngest-queen-scheduler.t27 delivers the events. This file adds no second queue,
; lease registry, bee registry or review: it closes the gaps dispatch.t27 measured, in its own words:
;   EVENT_RULE        "no event IDs and no event log: GitHub is polled each round"
;   TASK_LEASE_RULE   "a bee the container runs has no per-task lease and no heartbeat"
;   WRITER_RULE       "the writer that starts a dispatch does not check the table"
;   CANCEL_RULE       "none: no route aborts a running turn or drops a dispatch"
;   CHOICE_RULE       "take the FIRST that survives" -- one task per round, whatever the free slots
; Measured pulse at the time of writing (#6628, 2026-10-06 03:09:44Z): 17 active of 70 workers, 53 idle,
; about 145 dispatchable issues, 150 issues held by attempts that were not running, 103 finished but
; unreviewed, 26 open bee pull requests (9 conflicted), 0 bee merges in 6 h, 7.37 finished dispatches an
; hour. 53 idle slots beside 145 dispatchable issues is the first-only choice plus holds with no lease.
; The lifecycle this file makes canonical (the issue's words):
;   event -> Queen wakes -> select/create/reuse domain bee -> assign -> execute -> evidence ->
;   verify/review -> compact active context -> next task
; Not here, and why: the supervisor's wiring is TypeScript in gHashTag/BrowserOS (hand-written foreign
; code, not written from this repository); it imports these constants from `t27c gen-js` of this file
; and mirrors the functions, as it does for priority.t27 and review_valve.t27. Until it does, every rule
; below is a contract with tests, not a measured runtime behaviour. ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module QueenControl;

; --- 1. Events wake the Queen; the tick only reconciles ---------------------------------------------

/// Event kinds. Each one is published once, with a per-stream sequence number, by the component that
/// caused it: the supervisor (created, ended, lease expired, heartbeat), a bee (evidence), the reviewer
/// (review), a person through the authenticated board (assign, cancel), the Inngest cron (tick).
pub const EV_TASK_CREATED : u8 = 0;
pub const EV_TASK_ENDED : u8 = 1;
pub const EV_WORKER_IDLE : u8 = 2;
pub const EV_LEASE_EXPIRED : u8 = 3;
pub const EV_EVIDENCE : u8 = 4;
pub const EV_REVIEW : u8 = 5;
pub const EV_ASSIGN : u8 = 6;
pub const EV_CANCEL : u8 = 7;
pub const EV_HEARTBEAT : u8 = 8;
pub const EV_TICK : u8 = 9;
pub const EVENT_KINDS : u8 = 10;

/// Inngest event names, index = kind. The host registers one function per name on the existing app
/// (APP_ID "t27-queen"); a name is the only thing a publisher needs to know.
pub const EVENT_NAMES : [10]str = [
    "queen/task.created", "queen/task.ended", "queen/worker.idle", "queen/lease.expired",
    "queen/task.evidence", "queen/task.reviewed", "queen/task.assign", "queen/task.cancel",
    "queen/lease.heartbeat", "queen/tick"
];

/// What a woken Queen does. Every reaction is bounded: one decision, its writes, done.
pub const R_NONE : u8 = 0;
pub const R_DISPATCH : u8 = 1;
pub const R_REVIEW : u8 = 2;
pub const R_RECLAIM : u8 = 3;
pub const R_ASSIGN : u8 = 4;
pub const R_CANCEL : u8 = 5;
pub const R_RECONCILE : u8 = 6;

/// The reconciliation tick. Five minutes: it repairs a lost event, it is not how work moves. The
/// supervisor's round today runs on its own timer and on POST; with events it runs on both.
pub const RECONCILE_SECONDS : u32 = 300;

pub fn reaction_of(kind: u8) -> u8 {
    if (kind == EV_TASK_CREATED) { return R_DISPATCH; }
    if (kind == EV_TASK_ENDED) { return R_REVIEW; }
    if (kind == EV_WORKER_IDLE) { return R_DISPATCH; }
    if (kind == EV_LEASE_EXPIRED) { return R_RECLAIM; }
    if (kind == EV_EVIDENCE) { return R_REVIEW; }
    if (kind == EV_REVIEW) { return R_DISPATCH; }
    if (kind == EV_ASSIGN) { return R_ASSIGN; }
    if (kind == EV_CANCEL) { return R_CANCEL; }
    if (kind == EV_TICK) { return R_RECONCILE; }
    return R_NONE;
}

/// A heartbeat renews a lease in the store and needs no decision; every other kind wakes the Queen.
pub fn wakes_queen(kind: u8) -> bool {
    return reaction_of(kind) != R_NONE;
}

/// How long a transition waits before the Queen reacts. A waking event is handled at once; only an
/// event that wakes nobody is left to the next reconciliation.
pub fn wake_delay_seconds(kind: u8, seconds_to_tick: u32) -> u32 {
    if (wakes_queen(kind)) { return 0; }
    return seconds_to_tick;
}

/// Idempotency: an event is applied only when its sequence number is past the last one applied on its
/// stream. A redelivery or an older event changes nothing.
pub fn event_applies(last_applied: u64, seq: u64) -> bool {
    return seq > last_applied;
}

/// Wakes that arrive during a reaction coalesce into one more reaction, as dispatch.t27's
/// followup_rounds does for round requests.
pub fn followup_reactions(wakes_during: u32) -> u32 {
    if (wakes_during > 0) { return 1; }
    return 0;
}

/// The tick reconciles when nothing has woken the Queen for a whole period, or a period has passed
/// since the last reconciliation whatever the events did.
pub fn reconcile_due(since_last_event: u32, since_last_reconcile: u32) -> bool {
    if (since_last_reconcile >= RECONCILE_SECONDS) { return true; }
    return since_last_event >= RECONCILE_SECONDS;
}

; --- 2. Task leases: one fenced claim per task, renewed by heartbeat --------------------------------

/// The task lease has the shape of the Queen's own queen_lease (dispatch.t27 LEASE_RULE): one
/// INSERT ... ON CONFLICT DO UPDATE ... WHERE free OR expired OR same holder, which bumps a fence that
/// never restarts. Holder 0 means no holder. The heartbeat comes from the agent runtime, not from the
/// model turn, so a long turn keeps its lease and a dead runtime loses it within one TTL.
pub const NO_HOLDER : u32 = 0;
pub const TASK_LEASE_TTL_SECONDS : u32 = 180;
pub const TASK_HEARTBEAT_SECONDS : u32 = 60;

/// The atomic claim. A claimant passes the fence it read; the write lands only if the fence is still
/// that value and the task is free, expired, or already its own. Two claimants that read the same
/// fence cannot both land: the first bumps it.
pub fn claim_lands(holder: u32, me: u32, expired: bool, fence: u64, fence_read: u64) -> bool {
    if (me == NO_HOLDER) { return false; }
    if (fence != fence_read) { return false; }
    if (holder == NO_HOLDER) { return true; }
    if (expired) { return true; }
    return holder == me;
}

pub fn fence_after_claim(fence: u64) -> u64 {
    return fence + 1;
}

/// A renewal lands only for the live holder at the fence it claimed with. A runtime that slept past
/// its TTL renews nothing: the lease may already be someone else's.
pub fn renew_lands(holder: u32, me: u32, expired: bool, fence: u64, my_fence: u64) -> bool {
    if (expired) { return false; }
    if (holder != me) { return false; }
    return fence == my_fence;
}

pub fn lease_expired(seconds_since_renewal: u32) -> bool {
    return seconds_since_renewal >= TASK_LEASE_TTL_SECONDS;
}

/// Every write a bee makes about its task -- evidence, an ending, a branch head -- carries its fence
/// and lands only at the current one. A reclaimed bee that wakes up late writes nothing.
pub fn write_lands(fence: u64, my_fence: u64) -> bool {
    return fence == my_fence;
}

/// Reclamation: an expired lease on an unfinished task frees the task at once (EV_LEASE_EXPIRED ->
/// R_RECLAIM), instead of waiting for dispatch.t27's 120-minute age reaper.
pub fn reclaimable(finished: bool, seconds_since_renewal: u32) -> bool {
    if (finished) { return false; }
    return lease_expired(seconds_since_renewal);
}

; --- 3. A person assigns and cancels through the same machine ----------------------------------------

/// Where the next task comes from. A person's assignment is taken before the automatic choice; the
/// automatic choice orders by specs/queen/priority.t27.
pub const SRC_NONE : u8 = 0;
pub const SRC_MANUAL : u8 = 1;
pub const SRC_AUTO : u8 = 2;

pub fn next_source(manual_pending: bool, auto_eligible: bool) -> u8 {
    if (manual_pending) { return SRC_MANUAL; }
    if (auto_eligible) { return SRC_AUTO; }
    return SRC_NONE;
}

/// Answers to a manual assignment. A person does not take a task out from under a live lease: they
/// cancel it first, so there is exactly one road by which a lease ends early.
pub const A_OK : u8 = 0;
pub const A_HELD : u8 = 1;
pub const A_AGENT_BUSY : u8 = 2;
pub const A_WRONG_DOMAIN : u8 = 3;

pub fn assign_answer(task_leased_live: bool, agent_idle: bool, domain_match: bool) -> u8 {
    if (task_leased_live) { return A_HELD; }
    if (domain_match == false) { return A_WRONG_DOMAIN; }
    if (agent_idle == false) { return A_AGENT_BUSY; }
    return A_OK;
}

/// Cancellation. Any dispatch that is not accepted can be cancelled: a running one is interrupted
/// (its agent is told to stop and compact), a finished one leaves review. An accept is done; it is
/// taken back only by the CI take-back of dispatch.t27. A cancel bumps the fence, so the interrupted
/// bee's late writes do not land, and frees the issue's files at once.
pub fn cancel_allowed(accepted: bool) -> bool {
    return accepted == false;
}

pub fn fence_after_cancel(fence: u64) -> u64 {
    return fence + 1;
}

/// A cancelled attempt is an interruption: it is not counted against the issue's retries
/// (dispatch.t27 counts_against_issue).
pub fn cancel_counts_against_issue() -> bool {
    return false;
}

; --- 4. Capacity is computed at every wake; every free slot is offered --------------------------------

/// Free slots: the least of what keys and lanes allow, the configured ceiling, and what memory holds.
/// Recomputed on every wake, so a key added or a bee ended raises it without a restart.
pub fn capacity(keys: u32, lanes: u32, max_workers: u32, free_mb: u32, mb_per_bee: u32) -> u32 {
    var cap : u32 = keys * lanes;
    if (max_workers < cap) { cap = max_workers; }
    if (mb_per_bee > 0) {
        var by_memory : u32 = free_mb / mb_per_bee;
        if (by_memory < cap) { cap = by_memory; }
    }
    return cap;
}

pub fn free_slots(cap: u32, running: u32) -> u32 {
    if (running >= cap) { return 0; }
    return cap - running;
}

/// How many tasks one wake offers. Every free slot, up to the eligible candidates, instead of the
/// first one: the claims of section 2 make the parallel offers safe.
pub fn offers_per_wake(slots: u32, eligible: u32) -> u32 {
    if (eligible < slots) { return eligible; }
    return slots;
}

/// Placement: a task goes to an agent of its own domain with the memory it asks for.
pub fn fits(agent_domain: u32, task_domain: u32, agent_free_mb: u32, need_mb: u32) -> bool {
    if (agent_domain != task_domain) { return false; }
    return agent_free_mb >= need_mb;
}

; --- 5. Domain agents persist; the task context does not ----------------------------------------------

/// The domains of the agent population. A small fixed set, not an agent per task.
pub const DOMAINS : [4]str = [
    "t27-c: the C and assembler backends",
    "t27-b: the native backend and the compiler",
    "specs: .t27 specifications, seals and their tests",
    "queen-ops: the supervisor, its reviewers and the board"
];
pub const DOMAIN_COUNT : u32 = 4;
/// Runtimes per domain, originals and clones together.
pub const DOMAIN_CAP : u32 = 4;

/// Agent runtime states. BOOT happens once per runtime; a finished task goes through COMPACT back to
/// IDLE without a rebuild.
pub const AG_BOOT : u8 = 0;
pub const AG_IDLE : u8 = 1;
pub const AG_BUSY : u8 = 2;
pub const AG_COMPACT : u8 = 3;
pub const AG_RETIRED : u8 = 4;
pub const AG_ILLEGAL : u8 = 99;

pub const AE_READY : u8 = 0;
pub const AE_ASSIGN : u8 = 1;
pub const AE_TASK_DONE : u8 = 2;
pub const AE_INTERRUPT : u8 = 3;
pub const AE_COMPACTED : u8 = 4;
pub const AE_RETIRE : u8 = 5;

pub fn agent_next(state: u8, ev: u8) -> u8 {
    if (state == AG_BOOT) {
        if (ev == AE_READY) { return AG_IDLE; }
        return AG_ILLEGAL;
    }
    if (state == AG_IDLE) {
        if (ev == AE_ASSIGN) { return AG_BUSY; }
        if (ev == AE_RETIRE) { return AG_RETIRED; }
        return AG_ILLEGAL;
    }
    if (state == AG_BUSY) {
        if (ev == AE_TASK_DONE) { return AG_COMPACT; }
        if (ev == AE_INTERRUPT) { return AG_COMPACT; }
        return AG_ILLEGAL;
    }
    if (state == AG_COMPACT) {
        if (ev == AE_COMPACTED) { return AG_IDLE; }
        return AG_ILLEGAL;
    }
    return AG_ILLEGAL;
}

/// What compaction keeps. The active task context is cleared; the runtime, its identity, its build and
/// its verified skill lineage stay. Skills are execution state, not truth: they are kept because they
/// were verified, and they never stand in for task, lease or review state.
pub fn context_after_compact(context_tokens: u32) -> u32 {
    return 0;
}

pub fn lineage_after_compact(lineage: u64) -> u64 {
    return lineage;
}

pub fn builds_after_task(builds: u32) -> u32 {
    return builds;
}

/// How a task gets an agent: reuse an idle one of its domain, else clone one while the domain is under
/// its cap, else wait. The Queen never takes the task herself.
pub const P_REUSE : u8 = 0;
pub const P_CLONE : u8 = 1;
pub const P_WAIT : u8 = 2;

pub fn placement(idle_in_domain: u32, total_in_domain: u32) -> u8 {
    if (idle_in_domain > 0) { return P_REUSE; }
    if (total_in_domain < DOMAIN_CAP) { return P_CLONE; }
    return P_WAIT;
}

pub fn queen_executes_tasks() -> bool {
    return false;
}

/// A clone shares its parent's skill lineage and nothing else: a new runtime identity, its own lease
/// holder id, no task, no fence.
pub fn clone_lineage(parent_lineage: u64) -> u64 {
    return parent_lineage;
}

pub fn clone_holder(parent_holder: u32, next_free_id: u32) -> u32 {
    if (next_free_id == parent_holder) { return NO_HOLDER; }
    return next_free_id;
}

/// Authority. What an agent remembers about its task never overrides the store: the canonical state
/// is the answer, and a write lands by its fence alone, whatever the agent believes.
pub fn authoritative_state(canonical: u32, agent_belief: u32) -> u32 {
    return canonical;
}

pub fn agent_write_lands(agent_believes_it_holds: bool, fence: u64, my_fence: u64) -> bool {
    return write_lands(fence, my_fence);
}

; --- 6. A new attempt starts from the branch it inherits ----------------------------------------------

/// Measured 2026-10-06 (#6657): the supervisor cuts every attempt from the base (queen-dispatch.ts
/// prepareWorktree: `git worktree add -B queen-<issue> <path> <base>`), and the runner keeps the remote
/// tip only when that tip is its own last push. So a re-dispatch over finished, unjudged work started
/// over from the base. When the Queen then accepted the new attempt, its head did not descend from the
/// tip already on the remote, the export (which never forces) refused it, and the accept never reached
/// a pull request: 73 of the 102 accepted, never-pushed heads counted that day had exactly this shape,
/// every one newer than the tip it could not replace, and 71 of those 73 tips had never been published.
pub const ST_BASE : u8 = 0;
pub const ST_TIP : u8 = 1;
pub const ST_HOLD : u8 = 2;

/// What the remote `queen-<issue>` tip carries when a new attempt is about to start.
/// TIP_NONE: no branch, or a tip already on the base -- nothing to inherit.
/// TIP_UNJUDGED: finished work the Queen has no verdict on yet.
/// TIP_SENT_BACK: judged and not accepted (sendBack, escalate, wait, empty).
/// TIP_ACCEPTED: accepted at this head, and no pull request on it has closed.
/// TIP_PR_CLOSED: accepted and published, and the pull request closed unmerged.
pub const TIP_NONE : u8 = 0;
pub const TIP_UNJUDGED : u8 = 1;
pub const TIP_SENT_BACK : u8 = 2;
pub const TIP_ACCEPTED : u8 = 3;
pub const TIP_PR_CLOSED : u8 = 4;

/// Where the next attempt starts. Work that is still waiting -- for a verdict, or for publish and
/// review after an accept -- is held, not restarted: the hold ends when that verdict or review lands
/// (EV_REVIEW), so it needs no clock and no lease. Judged-and-declined work is inherited, so the next
/// bee continues from it and its push is a fast-forward. A tip code this file does not know holds.
pub fn attempt_start(tip: u8) -> u8 {
    if (tip == TIP_NONE) { return ST_BASE; }
    if (tip == TIP_SENT_BACK) { return ST_TIP; }
    if (tip == TIP_PR_CLOSED) { return ST_TIP; }
    return ST_HOLD;
}

/// A new attempt's push lands only as a fast-forward of the tip it started from, leased on that exact
/// tip. An attempt started from the tip always descends from it, so a refusal means the tip moved
/// under the attempt: the attempt is the stale one, never the tip.
pub fn attempt_push_lands(tip_moved: bool, descends_from_tip: bool) -> bool {
    if (tip_moved) { return false; }
    return descends_from_tip;
}

/// Recovery for attempts already cut from the base; tools/queen/export_push.py `may_supersede` mirrors
/// it. An exported head that does not descend from the remote tip replaces that tip only when the
/// Queen accepted exactly that head, it is newer than the tip (a newer tip is a later attempt still
/// waiting for her), and no open pull request heads the branch. The old tip is kept first, under the
/// tag queen-superseded/<issue>/<sha12>, so no commit is lost.
pub fn may_supersede(accepted: bool, exported_newer: bool, open_pull_request: bool) -> bool {
    if (accepted == false) { return false; }
    if (open_pull_request) { return false; }
    return exported_newer;
}

pub fn supersede_keeps_old_tip() -> bool {
    return true;
}

invariant every_kind_has_a_name { assert EVENT_KINDS == 10 and EV_TICK == EVENT_KINDS - 1; }
invariant the_heartbeat_beats_inside_the_ttl { assert TASK_HEARTBEAT_SECONDS * 3 == TASK_LEASE_TTL_SECONDS; }
invariant the_lease_beats_the_age_reaper { assert TASK_LEASE_TTL_SECONDS < 120 * 60; }
invariant the_tick_is_slower_than_a_lease { assert RECONCILE_SECONDS > TASK_LEASE_TTL_SECONDS; }
invariant the_population_is_small { assert DOMAIN_CAP * DOMAIN_COUNT <= 70; }
invariant illegal_is_outside_every_agent_state { assert AG_ILLEGAL > AG_RETIRED; }

test a_synthetic_task_ended_event_wakes_the_queen_before_the_tick {
    assert wakes_queen(EV_TASK_ENDED) == true;
    assert reaction_of(EV_TASK_ENDED) == R_REVIEW;
    assert wake_delay_seconds(EV_TASK_ENDED, 299) == 0;
    assert wake_delay_seconds(EV_WORKER_IDLE, 299) == 0;
    assert wake_delay_seconds(EV_LEASE_EXPIRED, 1) == 0;
    assert wakes_queen(EV_HEARTBEAT) == false;
    assert wake_delay_seconds(EV_HEARTBEAT, 299) == 299;
    assert reaction_of(EV_TICK) == R_RECONCILE;
    assert reaction_of(EV_ASSIGN) == R_ASSIGN;
    assert reaction_of(EV_CANCEL) == R_CANCEL;
}

test a_redelivered_event_changes_nothing {
    assert event_applies(41, 42) == true;
    assert event_applies(42, 42) == false;
    assert event_applies(42, 7) == false;
    assert followup_reactions(9) == 1;
    assert followup_reactions(0) == 0;
}

test the_tick_reconciles_only_after_a_quiet_period {
    assert reconcile_due(10, 10) == false;
    assert reconcile_due(300, 10) == true;
    assert reconcile_due(10, 300) == true;
    assert reconcile_due(299, 299) == false;
}

test two_claimants_on_one_fence_land_once {
    // both read fence 0 on a free task; agent 7 writes first
    assert claim_lands(NO_HOLDER, 7, false, 0, 0) == true;
    var fence : u64 = fence_after_claim(0);
    // agent 9 still holds the fence it read before agent 7 landed
    assert claim_lands(7, 9, false, fence, 0) == false;
    // agent 9 re-reads: the lease is live and not its own
    assert claim_lands(7, 9, false, fence, 1) == false;
    // agent 7 claiming again at the current fence is its own lease
    assert claim_lands(7, 7, false, fence, 1) == true;
    // both see agent 7's lease expired at fence 1; agent 9 lands, agent 11 read the same fence
    assert claim_lands(7, 9, true, 1, 1) == true;
    assert claim_lands(9, 11, true, fence_after_claim(1), 1) == false;
    // nobody claims as holder zero
    assert claim_lands(NO_HOLDER, NO_HOLDER, false, 0, 0) == false;
}

test an_expired_lease_is_reclaimed_and_the_old_holder_writes_nothing {
    assert lease_expired(179) == false;
    assert lease_expired(180) == true;
    assert reclaimable(false, 180) == true;
    assert reclaimable(true, 9999) == false;
    assert reclaimable(false, 59) == false;
    // agent 9 takes the expired lease of agent 7 at fence 1
    assert claim_lands(7, 9, true, 1, 1) == true;
    var fence : u64 = fence_after_claim(1);
    assert renew_lands(9, 9, false, fence, 2) == true;
    // agent 7 wakes up with fence 1: no renewal, no evidence
    assert renew_lands(9, 7, false, fence, 1) == false;
    assert write_lands(fence, 1) == false;
    assert write_lands(fence, 2) == true;
    // a holder that slept past the ttl renews nothing
    assert renew_lands(9, 9, true, fence, 2) == false;
}

test a_person_assigns_first_and_cannot_steal_a_live_lease {
    assert next_source(true, true) == SRC_MANUAL;
    assert next_source(false, true) == SRC_AUTO;
    assert next_source(false, false) == SRC_NONE;
    assert assign_answer(true, true, true) == A_HELD;
    assert assign_answer(false, true, false) == A_WRONG_DOMAIN;
    assert assign_answer(false, false, true) == A_AGENT_BUSY;
    assert assign_answer(false, true, true) == A_OK;
}

test a_cancel_interrupts_frees_and_fences_out_the_bee {
    assert cancel_allowed(false) == true;
    assert cancel_allowed(true) == false;
    assert cancel_counts_against_issue() == false;
    var fence : u64 = fence_after_cancel(4);
    assert write_lands(fence, 4) == false;
    assert agent_next(AG_BUSY, AE_INTERRUPT) == AG_COMPACT;
}

test every_free_slot_is_offered_in_one_wake {
    // the pulse of #6628: 70 workers, 17 running, about 145 dispatchable
    var cap : u32 = capacity(14, 5, 70, 1000000, 1);
    assert cap == 70;
    assert free_slots(cap, 17) == 53;
    assert offers_per_wake(free_slots(cap, 17), 145) == 53;
    assert offers_per_wake(53, 3) == 3;
    // memory and the ceiling each bound it
    assert capacity(14, 5, 70, 4096, 512) == 8;
    assert capacity(2, 2, 70, 4096, 512) == 4;
    assert capacity(14, 5, 10, 4096, 0) == 10;
    assert free_slots(4, 9) == 0;
    assert fits(1, 1, 2048, 1024) == true;
    assert fits(1, 2, 2048, 1024) == false;
    assert fits(1, 1, 512, 1024) == false;
}

test one_runtime_takes_task_b_after_task_a_without_a_rebuild {
    var s0 : u8 = agent_next(AG_BOOT, AE_READY);
    assert s0 == AG_IDLE;
    // task A: assigned, 120000 tokens of context, done
    var s1 : u8 = agent_next(s0, AE_ASSIGN);
    assert s1 == AG_BUSY;
    var s2 : u8 = agent_next(s1, AE_TASK_DONE);
    assert s2 == AG_COMPACT;
    assert context_after_compact(120000) == 0;
    assert lineage_after_compact(6657) == 6657;
    assert builds_after_task(1) == 1;
    var s3 : u8 = agent_next(s2, AE_COMPACTED);
    assert s3 == AG_IDLE;
    // task B on the same runtime, with no BOOT in between
    var s4 : u8 = agent_next(s3, AE_ASSIGN);
    assert s4 == AG_BUSY;
    assert agent_next(AG_IDLE, AE_READY) == AG_ILLEGAL;
    assert agent_next(AG_BUSY, AE_ASSIGN) == AG_ILLEGAL;
    assert agent_next(AG_COMPACT, AE_ASSIGN) == AG_ILLEGAL;
    assert agent_next(AG_RETIRED, AE_READY) == AG_ILLEGAL;
}

test a_clone_keeps_the_lineage_and_gets_its_own_lease {
    assert placement(1, 3) == P_REUSE;
    assert placement(0, 3) == P_CLONE;
    assert placement(0, DOMAIN_CAP) == P_WAIT;
    assert queen_executes_tasks() == false;
    assert clone_lineage(6657) == 6657;
    var clone : u32 = clone_holder(7, 8);
    assert clone == 8;
    assert clone != 7;
    assert clone_holder(7, 7) == NO_HOLDER;
    // parent and clone race for one task: only one lands, through the same claim
    assert claim_lands(NO_HOLDER, 7, false, 0, 0) == true;
    assert claim_lands(7, clone, false, 1, 0) == false;
}

test agent_memory_never_overrides_the_store {
    assert authoritative_state(3, 1) == 3;
    assert agent_write_lands(true, 5, 4) == false;
    assert agent_write_lands(false, 5, 5) == true;
}

test a_re_dispatch_inherits_the_tip_and_never_restarts_waiting_work {
    assert attempt_start(TIP_NONE) == ST_BASE;
    assert attempt_start(TIP_UNJUDGED) == ST_HOLD;
    assert attempt_start(TIP_ACCEPTED) == ST_HOLD;
    assert attempt_start(TIP_SENT_BACK) == ST_TIP;
    assert attempt_start(TIP_PR_CLOSED) == ST_TIP;
    assert attempt_start(99) == ST_HOLD;
}

test an_attempt_from_the_tip_pushes_as_a_fast_forward {
    assert attempt_push_lands(false, true) == true;
    assert attempt_push_lands(true, true) == false;
    assert attempt_push_lands(false, false) == false;
}

test the_measured_jam_recovers_without_losing_a_commit {
    // #6657, 2026-10-06: accepted heads, each newer than an older, unpublished tip
    assert may_supersede(true, true, false) == true;
    assert may_supersede(false, true, false) == false;
    assert may_supersede(true, false, false) == false;
    assert may_supersede(true, true, true) == false;
    assert supersede_keeps_old_tip() == true;
}
