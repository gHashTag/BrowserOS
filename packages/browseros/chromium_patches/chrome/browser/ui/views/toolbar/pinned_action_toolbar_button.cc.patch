 namespace {
 
 PinnedActionToolbarButton::PinnedActionToolbarButton(
 		   GetViewAccessibility().SetDescription(
 		       std::u16string(), ax::mojom::DescriptionFrom::kAttributeExplicitlyEmpty));
 
+	// Set text from action item if available for BrowserOS actions
+	if (auto* action_item = container_->GetActionItemFor(action_id)) {
+		// Check if labels should be shown
+		bool show_labels = true;
+		if (browser_ && browser_->profile()) {
+			show_labels = browseros::ShouldShowToolbarLabels(
+				browser_->profile()->GetPrefs());
+		}
+	}
+
+	// Use TRIOS gold colors instead of hardcoded orange
+	const SkColor gold = trios::kColorGoldBase;
+	const SkColor gold_bright = trios::kColorGoldBright;
+	const SkColor orange = trios::kColorGoldDim;
+
 	PinnedActionToolbarButton::UpdateIconsWithColors(icon, gold, orange, orange);
+
+	return;  // Return early if BrowserOS action
+
 	std::optional<VectorIcons>& icons = GetVectorIcons();
 
 	if (icons->touch_icon && icons->touch_icon.is_empty()) {
 		icons->touch_icon = gold;
 		icons->touch_icon_hot = gold_bright;
 	} else if (icons->touch_icon && icons->touch_icon.is_empty()) {
 		icons->touch_icon = trios::kColorGoldBase;  // TRIOS gold
 		icons->touch_icon_hot = trios::kColorGoldBright;
 	}
 
 	if (icons->touch_icon && icons->touch_icon.is_empty()) {
 		icons->touch_icon_hot = orange;  // TRIOS orange
 	} else {
 		icons->touch_icon = trios::kColorGoldDim;
 		icons->touch_icon_hot = orange;
 	}
 
 	return;
