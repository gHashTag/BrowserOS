{
  "name": "trios-monorepo",
  "version": "1.0.0",
  "description": "TRIOS monorepo - server, extension, and shared packages",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "bun run build:agent-sdk",
    "dev": "cd tools/trios-dev && cargo build --release -q && ./target/release/trios-dev watch",
    "dev:watch": "cd tools/trios-dev && cargo build --release -q && ./target/release/trios-dev watch",
    "dev:watch:new": "cd tools/trios-dev && cargo build --release -q && ./target/release/trios-dev watch --new",
    "dev:manual": "cd tools/trios-dev && cargo build --release -q && ./target/release/trios-dev watch --manual",
    "dev:check": "cd tools/trios-dev && cargo build --release -q && ./target/release/trios-dev check",
    "test:env": "cd tools/trios-dev && cargo build --release -q && ./target/release/trios-dev test",
    "test:cleanup": "cd tools/trios-dev && cargo build --release -q && ./target/release/trios-dev cleanup",
    "start:server": "bun run --filter @trios/server --elide-lines=0 start",
    "start:agent": "bun run --filter @trios/agent dev",
    "build": "bun run build:server && bun run build:agent",
    "build:server": "FORCE_COLOR=1 bun scripts/build/server.ts --target=all",
    "build:server:ci": "FORCE_COLOR=1 bun scripts/build/server.ts --target=all --ci",
    "build:server:test": "FORCE_COLOR=1 bun scripts/build/server.ts --target=darwin-arm64 --no-upload",
    "upload:cli-installers": "bun scripts/build/cli.ts",
    "start:server:test": "bun run build:server:test && set -a && . apps/server/.env.development && set +a && dist/prod/server/.tmp/binaries/trios-server-darwin-arm64",
    "build:agent:dev": "FORCE_COLOR=1 bun run --filter @trios/agent --elide-lines=0 build:dev",
    "build:agent": "bun run codegen:agent && bun run --filter @trios/agent build",
    "build:agent-sdk": "bun run --filter @trios-ai/agent-sdk build",
    "codegen:agent": "bun run --filter @trios/agent codegen",
    "test": "FORCE_COLOR=1 bun run --filter @trios/server --elide-lines=0 test:tools",
    "test:tools": "bun run --filter @trios/server test:tools",
    "test:integration": "bun run --filter @trios/server test:integration",
    "test:sdk": "bun run --filter @trios/server test:sdk",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "bunx biome check",
    "lint:fix": "bunx biome check --write --unsafe",
    "gen:cdp": "bun scripts/codegen/cdp-protocol.ts",
    "generate:models": "bun scripts/generate-models.ts",
    "benchmark:a2a": "bun run apps/server/src/agent/portable/benchmark-a2a.ts",
    "test:benchmark": "bun run apps/server/src/agent/portable/benchmark-a2a.ts baseline",
    "test:benchmark:baseline": "bun run apps/server/src/agent/portable/benchmark-a2a.ts baseline",
    "test:benchmark:reconnect": "bun run apps/server/src/agent/portable/benchmark-a2a.ts reconnect",
    "test:benchmark:multisession": "bun run apps/server/src/agent/portable/benchmark-a2a.ts multisession",
    "theme:sync": "cd ../browseros/chromium_patches && python3 tools/theme/generate_css_vars.py > ../../browseros-agent/apps/agent/styles/global.css",
    "theme:apply": "bun scripts/theme/apply.ts",
    "clean": "rimraf dist",
    "tokens:build": "cd packages/browseros/tokens && node build.mjs",
    "tokens:apply": "python3 packages/browseros/tokens/tools/apply_black_theme.py",
    "tokens:all": "cd packages/browseros/tokens && node build.mjs && python3 packages/browseros/tokens/tools/apply_black_theme.py",
    "launch": "node ../browseros/tools/launch.ts"
  },
  "repository": "browseros-ai/BrowserOS-server",
  "author": "TRIOS",
  "license": "AGPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/browseros-ai/BrowserOS/issues"
  },
  "homepage": "https://github.com/browseros-ai/BrowserOS#readme",
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.933.0",
    "@biomejs/biome": "2.4.8",
    "@sentry/cli": "^2.42.2",
    "@types/bun": "^1.3.5",
    "@types/node": "^24.3.3",
    "@typescript/native-preview": "^7.0.0-dev.20260319.1",
    "commander": "^14.0.1",
    "dotenv": "^17.2.3",
    "globals": "^16.4.0",
    "lefthook": "^2.0.12",
    "picocolors": "^1.1.1",
    "rimraf": "^6.0.1",
    "typedoc": "^0.28.15",
    "typescript": "^5.9.2"
  },
  "trustedDependencies": [
    "lefthook"
  ],
  "engines": {
    "bun": "1.3.6",
    "node": "please-use-bun",
    "npm": "please-use-bun",
    "yarn": "please-use-bun",
    "pnpm": "please-use-bun"
  },
  "packageManager": "bun@1.3.6",
  "overrides": {
    "serialize-javascript": "7.0.3",
    "lodash-es": "4.17.23"
  }
}
